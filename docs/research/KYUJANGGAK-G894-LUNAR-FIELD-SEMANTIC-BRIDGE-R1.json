  "direct_method_fragments": [
    {
      "page_id": "018a",
      "heading": "求經朔弦望入遲疾曆及限數",
      "stable_surface": "視各入轉在轉中已下為疾曆已上減去轉中為遲曆置遲疾曆日及分秒以十二限二十分乘之得限數",
      "mechanical_role": "Defines the current half as 疾曆 or 遲曆 and derives 限數 from the corresponding 遲疾曆 coordinate."
    },
    {
      "page_id": "041b",
      "heading": "求遲疾差",
      "stable_surface": "置遲疾曆日及分秒以遲疾曆日率減之以其下損益分乘之如八百二十而一益加損減其下遲疾度即遲疾差",
      "transcription_scope_note": "A small interlinear exception around insufficient subtraction is intentionally omitted here because it is not needed to identify the six table fields.",
      "mechanical_role": "Subtract the row day-rate anchor; multiply the residual by 損益分; divide by 820; add or subtract the result from the row 遲疾度 to obtain 遲疾差."
    },
    {
      "page_id": "041b",
      "heading": "求加減差",
      "stable_surface": "視經朔弦望盈縮差與遲疾差同名相從異名相消以八百二十乘之以所入遲疾限下行度除之即為加減差",
      "mechanical_role": "Combine the solar 盈縮差 and lunar 遲疾差 by sign, multiply by 820, then divide by the applicable current-half limit line-speed field."
    }
  ],
