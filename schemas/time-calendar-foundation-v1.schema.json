{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/chinaneedM/ziwei-bazi-model/schemas/time-calendar-foundation-v1.schema.json",
  "title": "Ziwei-Bazi Time/Calendar Foundation Result V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "input",
    "input_interval",
    "policy_registry_version",
    "selected_policies",
    "classification_count",
    "branches",
    "unresolved_samples",
    "metadata"
  ],
  "properties": {
    "schema": {"const": "TIME-CALENDAR-FOUNDATION-RESULT-V1"},
    "status": {
      "enum": [
        "RESOLVED",
        "RESOLVED_RANGE_SINGLE_CLASSIFICATION",
        "MULTI_CANDIDATE_OR_BOUNDARY_UNCERTAINTY",
        "UNRESOLVED_CIVIL_TIME"
      ]
    },
    "input": {"$ref": "#/$defs/birthInput"},
    "input_interval": {
      "type": "object",
      "required": ["uncertainty_seconds_each_side", "sample_count", "ambiguous_sample_count"],
      "properties": {
        "uncertainty_seconds_each_side": {"type": "integer", "minimum": 0},
        "sample_count": {"type": "integer", "minimum": 1},
        "ambiguous_sample_count": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "policy_registry_version": {"type": "string", "minLength": 1},
    "selected_policies": {"type": "object"},
    "classification_count": {"type": "integer", "minimum": 0},
    "branches": {"type": "array", "items": {"$ref": "#/$defs/resolvedBranch"}},
    "unresolved_samples": {"type": "array", "items": {"type": "object"}},
    "metadata": {
      "type": "object",
      "required": ["foundation_version", "facts_and_policies_separated", "canonical_sources_modified"],
      "properties": {
        "foundation_version": {"const": "PHASE-01-R1"},
        "facts_and_policies_separated": {"const": true},
        "canonical_sources_modified": {"const": false}
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "birthInput": {
      "type": "object",
      "required": [
        "reported_local_datetime",
        "birth_place",
        "latitude",
        "longitude",
        "timezone_id",
        "precision",
        "uncertainty_seconds",
        "input_time_type"
      ],
      "properties": {
        "reported_local_datetime": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?$"
        },
        "birth_place": {"type": "string", "minLength": 1},
        "latitude": {"type": "number", "minimum": -90, "maximum": 90},
        "longitude": {"type": "number", "minimum": -180, "maximum": 180},
        "timezone_id": {"type": "string", "minLength": 1},
        "precision": {"enum": ["EXACT_SECOND", "NEAREST_MINUTE", "NEAREST_HOUR", "APPROXIMATE"]},
        "uncertainty_seconds": {"type": "integer", "minimum": 0},
        "input_time_type": {"enum": ["CIVIL", "ALREADY_TRUE_SOLAR", "UNKNOWN"]}
      },
      "additionalProperties": false
    },
    "resolvedBranch": {
      "type": "object",
      "required": [
        "sample_reported_local_datetime",
        "civil_time",
        "selected_civil_candidate",
        "solar_time",
        "ziwei_calendar",
        "bazi_time",
        "audit_trace"
      ],
      "properties": {
        "sample_reported_local_datetime": {"type": "string"},
        "civil_time": {"type": "object"},
        "selected_civil_candidate": {"type": "object"},
        "solar_time": {"type": "object"},
        "ziwei_calendar": {"type": "object"},
        "bazi_time": {"type": "object"},
        "audit_trace": {
          "type": "object",
          "required": ["schema", "steps"],
          "properties": {
            "schema": {"const": "TIME-CALENDAR-AUDIT-TRACE-V1"},
            "steps": {
              "type": "array",
              "minItems": 7,
              "items": {
                "type": "object",
                "required": ["sequence", "operation", "fact_or_policy", "inputs", "outputs", "metadata"],
                "properties": {
                  "sequence": {"type": "integer", "minimum": 1},
                  "operation": {"type": "string"},
                  "fact_or_policy": {"enum": ["FACT", "POLICY"]},
                  "inputs": {"type": "object"},
                  "outputs": {"type": "object"},
                  "metadata": {"type": "object"}
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
