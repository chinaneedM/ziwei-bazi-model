{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/bazi-classical-relation-lifecycle-evidence-matrix-r1.schema.json",
  "title": "Bazi Classical Relation Lifecycle Evidence Matrix R1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "audit_id",
    "authority",
    "scope",
    "method",
    "closed_vocabularies",
    "conflict_groups",
    "records",
    "summary"
  ],
  "properties": {
    "schema": {"const": "BAZI-CLASSICAL-RELATION-LIFECYCLE-EVIDENCE-MATRIX-R1"},
    "audit_id": {"const": "BAZI-CLASSICAL-RELATION-LIFECYCLE-EVIDENCE-MATRIX-R1"},
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "canonical_source_path",
        "canonical_source_bytes",
        "canonical_source_sha256",
        "source_access_index_path",
        "source_access_index_sha256",
        "canonical_source_is_sole_authority",
        "prediction_source_selection_allowed"
      ],
      "properties": {
        "source_id": {"const": "S14"},
        "canonical_source_path": {"const": "sources/canonical/S14_八字合冲刑害墓库与结构变化库.txt"},
        "canonical_source_bytes": {"const": 3354845},
        "canonical_source_sha256": {"const": "b225e64fcf7238b27a634e653a6904403d518335aeca59372b32e02f4a560407"},
        "source_access_index_path": {"const": "sources/derived-access/S14/index.json"},
        "source_access_index_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "canonical_source_is_sole_authority": {"const": true},
        "prediction_source_selection_allowed": {"const": false}
      }
    },
    "scope": {"type": "object"},
    "method": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm_id",
        "all_indexed_segments_processed",
        "all_lines_considered",
        "format_support",
        "vocabulary_expansion",
        "coverage_claim_limit"
      ],
      "properties": {
        "algorithm_id": {"const": "S14_INDEX_ORDER_FULL_LINE_TWO_PASS_AUDIT_R1"},
        "all_indexed_segments_processed": {"const": true},
        "all_lines_considered": {"const": true},
        "format_support": {
          "const": ["MARKDOWN", "PLAIN_TEXT", "JSONL", "TSV", "CONTROL_ROWS"]
        },
        "coverage_claim_limit": {"const": "TARGET_RELATION_AND_LIFECYCLE_SCOPE_ONLY"},
        "vocabulary_expansion": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "seed_candidate_rule_id",
            "pass1_control_derivation_rule_id",
            "pass1_control_field",
            "pass1_control_role",
            "pass1_relation_morphemes",
            "pass1_discovered_terms",
            "vocabulary_closure_sha256",
            "pass2_vocabulary_only_record_count"
          ],
          "properties": {
            "seed_candidate_rule_id": {"const": "S14_RELATION_SIGNAL_AND_TYPED_DEPENDENCY_R1"},
            "pass1_control_derivation_rule_id": {"const": "S14_TYPED_TECHNICAL_TERM_RELATION_MORPHEME_R1"},
            "pass1_control_field": {"const": "RAW_TERM"},
            "pass1_control_role": {"const": "TECHNICAL_TERM"},
            "pass1_relation_morphemes": {"const": ["合", "冲", "刑", "害", "破", "会", "化", "绊", "局"]},
            "pass1_discovered_terms": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 2, "maxLength": 8}
            },
            "vocabulary_closure_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "pass2_vocabulary_only_record_count": {"type": "integer", "minimum": 1}
          }
        }
      }
    },
    "closed_vocabularies": {"type": "object"},
    "conflict_groups": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "conflict_group_id",
          "source_conflict_id",
          "linkage_basis",
          "relation_family",
          "evidence_ids",
          "resolution_status"
        ],
        "properties": {
          "conflict_group_id": {"type": "string", "pattern": "^S14-CONFLICT-"},
          "source_conflict_id": {"type": "string", "minLength": 1},
          "linkage_basis": {"const": "SHARED_EXPLICIT_SOURCE_CONFLICT_ID_AND_DISTINCT_SOURCE_ROLES"},
          "relation_family": {"type": "string"},
          "evidence_ids": {
            "type": "array",
            "minItems": 2,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^S14-EV-L[0-9]{5}-[0-9a-f]{12}$"}
          },
          "resolution_status": {"const": "UNRESOLVED_PROFILE_REVIEW_REQUIRED"}
        }
      }
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/evidenceRecord"}
    },
    "summary": {"type": "object"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "evidenceRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "source_id",
        "canonical_source_path",
        "canonical_source_sha256",
        "access_segment_id",
        "access_segment_path",
        "access_segment_sha256",
        "canonical_line_start",
        "canonical_line_end",
        "segment_local_line_start",
        "segment_local_line_end",
        "canonical_byte_start",
        "canonical_byte_end_exclusive",
        "passage_includes_line_ending",
        "passage_sha256",
        "source_heading_path",
        "source_record_type",
        "source_role",
        "source_conflict_id",
        "source_pairing_role",
        "exact_excerpt",
        "excerpt_is_complete_source_record_text",
        "relation_families",
        "participant_kind",
        "statement_class",
        "secondary_statement_classes",
        "condition_dependency_tags",
        "conflict_group_ids",
        "alternative_profile_labels",
        "runtime_dependency_map",
        "runtime_gap_tags",
        "review_status",
        "audit_notes"
      ],
      "properties": {
        "evidence_id": {"type": "string", "pattern": "^S14-EV-L[0-9]{5}-[0-9a-f]{12}$"},
        "source_id": {"const": "S14"},
        "canonical_source_path": {"const": "sources/canonical/S14_八字合冲刑害墓库与结构变化库.txt"},
        "canonical_source_sha256": {"const": "b225e64fcf7238b27a634e653a6904403d518335aeca59372b32e02f4a560407"},
        "access_segment_id": {"type": "string", "pattern": "^S14-[0-9]{4}$"},
        "access_segment_path": {"type": "string", "pattern": "^sources/derived-access/S14/segment-[0-9]{4}\\.txt$"},
        "access_segment_sha256": {"$ref": "#/$defs/sha256"},
        "canonical_line_start": {"type": "integer", "minimum": 1},
        "canonical_line_end": {"type": "integer", "minimum": 1},
        "segment_local_line_start": {"type": "integer", "minimum": 1},
        "segment_local_line_end": {"type": "integer", "minimum": 1},
        "canonical_byte_start": {"type": "integer", "minimum": 0},
        "canonical_byte_end_exclusive": {"type": "integer", "minimum": 1},
        "passage_includes_line_ending": {"type": "boolean"},
        "passage_sha256": {"$ref": "#/$defs/sha256"},
        "source_heading_path": {"type": "string"},
        "source_record_type": {"type": "string"},
        "source_role": {"type": "string"},
        "source_conflict_id": {"type": ["string", "null"], "minLength": 1},
        "source_pairing_role": {"type": ["string", "null"], "minLength": 1},
        "exact_excerpt": {"type": "string", "maxLength": 240},
        "excerpt_is_complete_source_record_text": {"type": "boolean"},
        "relation_families": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "STEM_FIVE_COMBINATION",
              "BRANCH_LIUHE",
              "BRANCH_CHONG",
              "BRANCH_CHUAN",
              "BRANCH_SANHE_COMPLETE",
              "BRANCH_ZIMAO_PUNISHMENT",
              "BRANCH_DIRECTIONAL_PUNISHMENT",
              "BRANCH_SELF_PUNISHMENT",
              "BRANCH_HARM",
              "BRANCH_BREAK",
              "BRANCH_PARTIAL_TRINE",
              "BRANCH_DIRECTIONAL_TRIAD",
              "HIDDEN_COMBINATION",
              "OTHER_UNRELEASED_RELATION",
              "CROSS_FAMILY_RELATION_LIFECYCLE"
            ]
          }
        },
        "participant_kind": {"enum": ["STEM", "BRANCH", "MIXED", "OTHER"]},
        "statement_class": {"type": "string"},
        "secondary_statement_classes": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "condition_dependency_tags": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "conflict_group_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "alternative_profile_labels": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "runtime_dependency_map": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["primitive", "status", "rationale"],
            "properties": {
              "primitive": {"type": "string"},
              "status": {
                "enum": [
                  "AVAILABLE_EXACTLY",
                  "AVAILABLE_AS_NEUTRAL_EVIDENCE_ONLY",
                  "PARTIALLY_AVAILABLE",
                  "MISSING_PRIMITIVE",
                  "OUTSIDE_CURRENT_RELATION_REGISTRY",
                  "SOURCE_SEMANTICS_AMBIGUOUS"
                ]
              },
              "rationale": {"type": "string"}
            }
          }
        },
        "runtime_gap_tags": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "review_status": {
          "enum": [
            "REVIEWED_R1",
            "CONFLICT_REQUIRES_REVIEW",
            "SOURCE_SEMANTICS_AMBIGUOUS",
            "RUNTIME_RELATION_GAP_DEFERRED"
          ]
        },
        "audit_notes": {"type": "string"}
      }
    }
  }
}
