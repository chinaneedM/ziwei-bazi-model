{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/chinaneedM/ziwei-bazi-model/schemas/bazi-stem-relation-positional-context-foundation-r1.schema.json",
  "title": "Bazi Stem Relation Positional Context Foundation R1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "typed_schema", "status", "upstream_natal_fact_hash",
    "positional_profile", "candidate_counts", "candidates", "events", "diagnostics"
  ],
  "properties": {
    "schema": {"const": "BAZI-STEM-RELATION-POSITIONAL-CONTEXT-FOUNDATION-RESULT-V1"},
    "typed_schema": {"const": "BAZI-STEM-RELATION-POSITIONAL-TYPED-RESOLUTION-V1"},
    "status": {"enum": ["RESOLVED", "MULTI_CANDIDATE", "FAILED"]},
    "upstream_natal_fact_hash": {"$ref": "#/$defs/hash"},
    "positional_profile": {"$ref": "#/$defs/profile"},
    "candidate_counts": {"$ref": "#/$defs/candidateCounts"},
    "candidates": {"type": "array", "items": {"$ref": "#/$defs/candidate"}},
    "events": {"type": "array", "items": {"type": "string"}},
    "diagnostics": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "ids": {
      "type": "array", "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "indices": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "integer", "minimum": 0}
    },
    "seedIds": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^BAZI-TEMPORAL-SEED:[0-9a-f]{64}$"}
    },
    "sourceRefs": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "profile": {
      "type": "object", "additionalProperties": false,
      "required": [
        "profile_id", "profile_version", "algorithm_id", "algorithm_version",
        "snapshot_rule_set_id", "snapshot_rule_set_version",
        "participant_position_rule_set_id", "participant_position_rule_set_version",
        "pair_position_rule_set_id", "pair_position_rule_set_version",
        "candidate_lineage_rule_set_id", "candidate_lineage_rule_set_version"
      ],
      "properties": {
        "profile_id": {"const": "BAZI-STEM-RELATION-POSITIONAL-CONTEXT-FOUNDATION-R1"},
        "profile_version": {"const": "1.0.0"},
        "algorithm_id": {"const": "BAZI-STEM-RELATION-POSITIONAL-ENGINE-V1"},
        "algorithm_version": {"const": "1.0.0"},
        "snapshot_rule_set_id": {"const": "BAZI-STEM-RELATION-POSITIONAL-SNAPSHOT-R1"},
        "snapshot_rule_set_version": {"const": "1.0.0"},
        "participant_position_rule_set_id": {"const": "BAZI-STEM-PARTICIPANT-POSITION-REFERENCE-R1"},
        "participant_position_rule_set_version": {"const": "1.0.0"},
        "pair_position_rule_set_id": {"const": "BAZI-STEM-PAIR-POSITIONAL-FACT-R1"},
        "pair_position_rule_set_version": {"const": "1.0.0"},
        "candidate_lineage_rule_set_id": {"const": "BAZI-POSITIONAL-INCIDENCE-LINEAGE-R1"},
        "candidate_lineage_rule_set_version": {"const": "1.0.0"}
      }
    },
    "candidateCounts": {
      "type": "object", "additionalProperties": false,
      "required": ["structural", "incidence"],
      "properties": {
        "structural": {"type": "integer", "minimum": 0},
        "incidence": {"type": "integer", "minimum": 0}
      }
    },
    "snapshot": {
      "type": "object", "additionalProperties": false,
      "required": [
        "snapshot_id", "snapshot_fact_hash", "source_incidence_snapshot_id",
        "source_incidence_snapshot_fact_hash", "source_incidence_fact_hash",
        "source_incidence_computation_hash", "source_natal_fact_hash",
        "source_natal_computation_hash", "source_temporal_fact_hash",
        "source_flow_fact_hash", "source_flow_computation_hash",
        "source_structural_fact_hash", "source_structural_computation_hash",
        "source_support_fact_hash", "source_support_computation_hash",
        "target_utc", "profile_id", "profile_version", "rule_set_id",
        "rule_set_version", "source_refs"
      ],
      "properties": {
        "snapshot_id": {"type": "string", "pattern": "^STEM_RELATION_POSITIONAL_SNAPSHOT:[0-9a-f]{64}$"},
        "snapshot_fact_hash": {"$ref": "#/$defs/hash"},
        "source_incidence_snapshot_id": {"type": "string", "pattern": "^RELATION_INCIDENCE_SNAPSHOT:[0-9a-f]{64}$"},
        "source_incidence_snapshot_fact_hash": {"$ref": "#/$defs/hash"},
        "source_incidence_fact_hash": {"$ref": "#/$defs/hash"},
        "source_incidence_computation_hash": {"$ref": "#/$defs/hash"},
        "source_natal_fact_hash": {"$ref": "#/$defs/hash"},
        "source_natal_computation_hash": {"$ref": "#/$defs/hash"},
        "source_temporal_fact_hash": {"$ref": "#/$defs/hash"},
        "source_flow_fact_hash": {"$ref": "#/$defs/hash"},
        "source_flow_computation_hash": {"$ref": "#/$defs/hash"},
        "source_structural_fact_hash": {"$ref": "#/$defs/hash"},
        "source_structural_computation_hash": {"$ref": "#/$defs/hash"},
        "source_support_fact_hash": {"$ref": "#/$defs/hash"},
        "source_support_computation_hash": {"$ref": "#/$defs/hash"},
        "target_utc": {"type": "string", "format": "date-time"},
        "profile_id": {"const": "BAZI-STEM-RELATION-POSITIONAL-CONTEXT-FOUNDATION-R1"},
        "profile_version": {"const": "1.0.0"},
        "rule_set_id": {"const": "BAZI-STEM-RELATION-POSITIONAL-SNAPSHOT-R1"},
        "rule_set_version": {"const": "1.0.0"},
        "source_refs": {"$ref": "#/$defs/sourceRefs"}
      }
    },
    "participantPosition": {
      "type": "object", "additionalProperties": false,
      "required": [
        "reference_id", "participant_instance_id", "stem", "element", "polarity",
        "participant_layer", "source_frame_id", "raw_position_token",
        "position_domain", "natal_pillar_ordinal",
        "is_natal_day_master_participant", "source_upstream_fact_hash",
        "source_incidence_reference_ids", "rule_set_id", "rule_set_version", "source_refs"
      ],
      "properties": {
        "reference_id": {"type": "string", "pattern": "^STEM_PARTICIPANT_POSITION_REFERENCE:[0-9a-f]{64}$"},
        "participant_instance_id": {"type": "string", "minLength": 1},
        "stem": {"type": "string", "minLength": 1, "maxLength": 1},
        "element": {"type": "string", "minLength": 1},
        "polarity": {"type": "string", "minLength": 1},
        "participant_layer": {"enum": ["NATAL", "DAYUN", "ANNUAL", "MONTHLY"]},
        "source_frame_id": {"type": ["string", "null"]},
        "raw_position_token": {"enum": ["YEAR", "MONTH", "DAY", "HOUR", "DAYUN", "ANNUAL", "MONTHLY"]},
        "position_domain": {"enum": ["NATAL_PILLAR", "TEMPORAL_FRAME"]},
        "natal_pillar_ordinal": {"type": ["integer", "null"], "minimum": 0, "maximum": 3},
        "is_natal_day_master_participant": {"type": "boolean"},
        "source_upstream_fact_hash": {"$ref": "#/$defs/hash"},
        "source_incidence_reference_ids": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "string", "pattern": "^RELATION_OCCURRENCE_REFERENCE:"}
        },
        "rule_set_id": {"const": "BAZI-STEM-PARTICIPANT-POSITION-REFERENCE-R1"},
        "rule_set_version": {"const": "1.0.0"},
        "source_refs": {"$ref": "#/$defs/sourceRefs"}
      }
    },
    "pairPosition": {
      "type": "object", "additionalProperties": false,
      "required": [
        "positional_fact_id", "source_relation_reference_id", "source_relation_id",
        "source_semantic_relation_id", "source_relation_type", "source_relation_family",
        "participant_instance_ids", "participant_position_reference_ids",
        "position_domain_pair", "natal_linear_order_comparable",
        "natal_pillar_ordinals", "natal_ordinal_distance",
        "intervening_natal_visible_stem_instance_ids",
        "contains_natal_day_master_participant",
        "natal_day_master_participant_instance_ids", "source_incidence_snapshot_id",
        "source_incidence_snapshot_fact_hash", "source_incidence_fact_hash",
        "rule_set_id", "rule_set_version", "source_refs"
      ],
      "properties": {
        "positional_fact_id": {"type": "string", "pattern": "^STEM_PAIR_POSITIONAL_FACT:[0-9a-f]{64}$"},
        "source_relation_reference_id": {"type": "string", "pattern": "^RELATION_OCCURRENCE_REFERENCE:"},
        "source_relation_id": {"type": "string", "minLength": 1},
        "source_semantic_relation_id": {"type": "string", "minLength": 1},
        "source_relation_type": {"const": "STEM_FIVE_COMBINATION"},
        "source_relation_family": {"const": "STEM_COMBINATION"},
        "participant_instance_ids": {
          "type": "array", "minItems": 2, "maxItems": 2,
          "items": {"type": "string", "minLength": 1}
        },
        "participant_position_reference_ids": {
          "type": "array", "minItems": 2, "maxItems": 2,
          "items": {"type": "string", "pattern": "^STEM_PARTICIPANT_POSITION_REFERENCE:"}
        },
        "position_domain_pair": {
          "type": "array", "minItems": 2, "maxItems": 2,
          "items": {"enum": ["NATAL_PILLAR", "TEMPORAL_FRAME"]}
        },
        "natal_linear_order_comparable": {"type": "boolean"},
        "natal_pillar_ordinals": {
          "type": "array", "maxItems": 2,
          "items": {"type": "integer", "minimum": 0, "maximum": 3}
        },
        "natal_ordinal_distance": {"type": ["integer", "null"], "minimum": 1, "maximum": 3},
        "intervening_natal_visible_stem_instance_ids": {"$ref": "#/$defs/ids"},
        "contains_natal_day_master_participant": {"type": "boolean"},
        "natal_day_master_participant_instance_ids": {"$ref": "#/$defs/ids"},
        "source_incidence_snapshot_id": {"type": "string", "pattern": "^RELATION_INCIDENCE_SNAPSHOT:"},
        "source_incidence_snapshot_fact_hash": {"$ref": "#/$defs/hash"},
        "source_incidence_fact_hash": {"$ref": "#/$defs/hash"},
        "rule_set_id": {"const": "BAZI-STEM-PAIR-POSITIONAL-FACT-R1"},
        "rule_set_version": {"const": "1.0.0"},
        "source_refs": {"$ref": "#/$defs/sourceRefs"}
      }
    },
    "context": {
      "type": "object", "additionalProperties": false,
      "required": [
        "snapshot", "participant_position_references", "stem_pair_positional_facts",
        "profile_id", "profile_version", "algorithm_versions"
      ],
      "properties": {
        "snapshot": {"$ref": "#/$defs/snapshot"},
        "participant_position_references": {
          "type": "array", "items": {"$ref": "#/$defs/participantPosition"}
        },
        "stem_pair_positional_facts": {
          "type": "array", "items": {"$ref": "#/$defs/pairPosition"}
        },
        "profile_id": {"const": "BAZI-STEM-RELATION-POSITIONAL-CONTEXT-FOUNDATION-R1"},
        "profile_version": {"const": "1.0.0"},
        "algorithm_versions": {
          "type": "object", "additionalProperties": false,
          "required": ["positional", "snapshot", "participant_position", "pair_position", "candidate_lineage"],
          "properties": {
            "positional": {"const": "1.0.0"},
            "snapshot": {"const": "1.0.0"},
            "participant_position": {"const": "1.0.0"},
            "pair_position": {"const": "1.0.0"},
            "candidate_lineage": {"const": "1.0.0"}
          }
        }
      }
    },
    "integrity": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "diagnostics", "algorithm_id", "algorithm_version"],
      "properties": {
        "status": {"enum": ["PASS", "FAIL"]},
        "diagnostics": {"type": "array"},
        "algorithm_id": {"const": "BAZI-STEM-RELATION-POSITIONAL-INTEGRITY-V1"},
        "algorithm_version": {"const": "1.0.0"}
      }
    },
    "hashes": {
      "type": "object", "additionalProperties": false,
      "required": ["fact_hash", "computation_hash", "algorithm_id", "algorithm_version"],
      "properties": {
        "fact_hash": {"$ref": "#/$defs/hash"},
        "computation_hash": {"$ref": "#/$defs/hash"},
        "algorithm_id": {"const": "BAZI-STEM-RELATION-POSITIONAL-HASH-V1"},
        "algorithm_version": {"const": "1.0.0"}
      }
    },
    "candidate": {
      "type": "object", "additionalProperties": false,
      "required": [
        "source_incidence_candidate_indices", "source_flow_candidate_indices",
        "source_structural_candidate_indices", "source_support_candidate_indices",
        "source_temporal_candidate_indices", "source_temporal_seed_ids",
        "source_incidence_lineage_binding_keys", "lineage_binding_keys",
        "context", "integrity", "hashes"
      ],
      "properties": {
        "source_incidence_candidate_indices": {"$ref": "#/$defs/indices"},
        "source_flow_candidate_indices": {"$ref": "#/$defs/indices"},
        "source_structural_candidate_indices": {"$ref": "#/$defs/indices"},
        "source_support_candidate_indices": {"$ref": "#/$defs/indices"},
        "source_temporal_candidate_indices": {"$ref": "#/$defs/indices"},
        "source_temporal_seed_ids": {"$ref": "#/$defs/seedIds"},
        "source_incidence_lineage_binding_keys": {"$ref": "#/$defs/ids"},
        "lineage_binding_keys": {"$ref": "#/$defs/ids"},
        "context": {"$ref": "#/$defs/context"},
        "integrity": {"$ref": "#/$defs/integrity"},
        "hashes": {"$ref": "#/$defs/hashes"}
      }
    }
  }
}
