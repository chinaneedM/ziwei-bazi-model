{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/chinaneedM/ziwei-bazi-model/schemas/ziwei-temporal-state-v1.schema.json",
  "title": "Ziwei Temporal State V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "rule_set_id",
    "rule_set_version",
    "algorithm_id",
    "algorithm_version",
    "daxian_direction",
    "first_daxian_nominal_age",
    "daxian_frames",
    "annual_frames",
    "monthly_frames",
    "minor_limit_frames"
  ],
  "properties": {
    "rule_set_id": {
      "const": "S10_CURRENT_TEMPORAL_R1"
    },
    "rule_set_version": {
      "const": "1.6.0"
    },
    "algorithm_id": {
      "const": "ZIWEI-TEMPORAL-FRAMES-V1"
    },
    "algorithm_version": {
      "const": "1.6.0"
    },
    "daxian_direction": {
      "enum": [
        "FORWARD",
        "REVERSE"
      ]
    },
    "first_daxian_nominal_age": {
      "type": "integer",
      "minimum": 2,
      "maximum": 6
    },
    "daxian_frames": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/daxian"
      }
    },
    "annual_frames": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/annual"
      }
    },
    "monthly_frames": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/monthly"
      }
    },
    "minor_limit_frames": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/minor"
      }
    }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "address": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "branch"
      ],
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 11
        },
        "branch": {
          "enum": [
            "子",
            "丑",
            "寅",
            "卯",
            "辰",
            "巳",
            "午",
            "未",
            "申",
            "酉",
            "戌",
            "亥"
          ]
        }
      }
    },
    "designation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "designation_id",
        "display_name",
        "address"
      ],
      "properties": {
        "designation_id": {
          "type": "string"
        },
        "display_name": {
          "type": "string"
        },
        "address": {
          "$ref": "#/$defs/address"
        }
      }
    },
    "transformation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "activation_id",
        "transformation_type",
        "target_entity_id",
        "target_display_name",
        "target_address",
        "source_layer",
        "source_stem",
        "context_id",
        "assignment_id",
        "mechanism_id",
        "generator_id",
        "algorithm_version",
        "source_refs"
      ],
      "properties": {
        "activation_id": {
          "type": "string"
        },
        "transformation_type": {
          "enum": [
            "化禄",
            "化权",
            "化科",
            "化忌"
          ]
        },
        "target_entity_id": {
          "type": "string"
        },
        "target_display_name": {
          "type": "string"
        },
        "target_address": {
          "$ref": "#/$defs/address"
        },
        "source_layer": {
          "enum": [
            "DAXIAN",
            "ANNUAL",
            "MONTH"
          ]
        },
        "source_stem": {
          "enum": [
            "甲",
            "乙",
            "丙",
            "丁",
            "戊",
            "己",
            "庚",
            "辛",
            "壬",
            "癸"
          ]
        },
        "context_id": {
          "type": "string"
        },
        "assignment_id": {
          "type": "string"
        },
        "mechanism_id": {
          "type": "string"
        },
        "generator_id": {
          "type": "string"
        },
        "algorithm_version": {
          "type": "string"
        },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "temporalAuxiliaryActivation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "activation_id",
        "entity_id",
        "display_name",
        "target_address",
        "source_layer",
        "source_stem",
        "context_id",
        "rule_id",
        "generator_id",
        "algorithm_version",
        "source_refs"
      ],
      "properties": {
        "activation_id": {
          "type": "string",
          "minLength": 1
        },
        "entity_id": {
          "enum": [
            "STAR.LUCUN",
            "STAR.QINGYANG",
            "STAR.TUOLUO",
            "STAR.WENCHANG",
            "STAR.WENQU",
            "STAR.TIANKUI",
            "STAR.TIANYUE",
            "STAR.TIANMA"
          ]
        },
        "display_name": {
          "enum": [
            "禄存",
            "擎羊",
            "陀罗",
            "文昌",
            "文曲",
            "天魁",
            "天钺",
            "天马"
          ]
        },
        "target_address": {
          "$ref": "#/$defs/address"
        },
        "source_layer": {
          "enum": [
            "DAXIAN",
            "ANNUAL",
            "MONTH"
          ]
        },
        "source_stem": {
          "enum": [
            "甲",
            "乙",
            "丙",
            "丁",
            "戊",
            "己",
            "庚",
            "辛",
            "壬",
            "癸"
          ]
        },
        "context_id": {
          "type": "string",
          "minLength": 1
        },
        "rule_id": {
          "enum": [
            "S10-STEM-LUCUN-QINGYANG-TUOLUO-R1",
            "S10-STEM-FLOW-WENCHANG-WENQU-R1",
            "S10-STEM-FLOW-KUI-YUE-CANDIDATES-R1",
            "S10-BRANCH-FLOW-TIANMA-CASE-CANDIDATES-R1"
          ]
        },
        "generator_id": {
          "enum": [
            "ZIWEI-TEMPORAL-LUCUN-YANG-TUO-V1",
            "ZIWEI-TEMPORAL-FLOW-WENCHANG-WENQU-V1",
            "ZIWEI-TEMPORAL-FLOW-KUI-YUE-CANDIDATES-V1",
            "ZIWEI-TEMPORAL-FLOW-TIANMA-CASE-CANDIDATES-V1"
          ]
        },
        "algorithm_version": {
          "enum": [
            "1.0.0",
            "1.0.1"
          ]
        },
        "source_refs": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "entity_id": {
                "enum": [
                  "STAR.LUCUN",
                  "STAR.QINGYANG",
                  "STAR.TUOLUO"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "rule_id": {
                "const": "S10-STEM-LUCUN-QINGYANG-TUOLUO-R1"
              },
              "generator_id": {
                "const": "ZIWEI-TEMPORAL-LUCUN-YANG-TUO-V1"
              }
            }
          },
          "else": {
            "if": {
              "properties": {
                "entity_id": {
                  "enum": [
                    "STAR.WENCHANG",
                    "STAR.WENQU"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "rule_id": {
                  "const": "S10-STEM-FLOW-WENCHANG-WENQU-R1"
                },
                "generator_id": {
                  "const": "ZIWEI-TEMPORAL-FLOW-WENCHANG-WENQU-V1"
                }
              }
            },
            "else": {
              "if": {
                "properties": {
                  "entity_id": {
                    "const": "STAR.TIANMA"
                  }
                }
              },
              "then": {
                "properties": {
                  "rule_id": {
                    "const": "S10-BRANCH-FLOW-TIANMA-CASE-CANDIDATES-R1"
                  },
                  "generator_id": {
                    "const": "ZIWEI-TEMPORAL-FLOW-TIANMA-CASE-CANDIDATES-V1"
                  }
                }
              },
              "else": {
                "properties": {
                  "rule_id": {
                    "const": "S10-STEM-FLOW-KUI-YUE-CANDIDATES-R1"
                  },
                  "generator_id": {
                    "const": "ZIWEI-TEMPORAL-FLOW-KUI-YUE-CANDIDATES-V1"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "entity_id": {
                "enum": [
                  "STAR.TIANKUI",
                  "STAR.TIANYUE"
                ]
              }
            },
            "required": [
              "entity_id"
            ]
          },
          "then": {
            "properties": {
              "algorithm_version": {
                "const": "1.0.1"
              }
            }
          },
          "else": {
            "properties": {
              "algorithm_version": {
                "const": "1.0.0"
              }
            }
          }
        }
      ]
    },
    "temporalAuxiliaryMethodCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id",
        "method_id",
        "authority_status",
        "activations",
        "source_refs",
        "fact_hash",
        "computation_hash"
      ],
      "properties": {
        "candidate_id": {
          "type": "string",
          "minLength": 1
        },
        "method_id": {
          "enum": [
            "S01-QS-STRICT-KUI-YUE-R1",
            "COMPAT-WENMO-KUI-YUE-R1",
            "S10-LIMIT-PALACE-BRANCH-TIANMA-CASE-R1",
            "S10-ANNUAL-BRANCH-TIANMA-CASE-R1"
          ]
        },
        "authority_status": {
          "enum": [
            "CANONICAL_SOURCE_TABLE",
            "EXTERNAL_CASE_COMPATIBILITY",
            "CASE_METHOD_ONLY",
            "S01_STRICT_PROJECT_CORPUS_METHOD"
          ]
        },
        "activations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/temporalAuxiliaryActivation"
          }
        },
        "source_refs": {
          "type": "array",
          "minItems": 5,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "fact_hash": {
          "$ref": "#/$defs/hash"
        },
        "computation_hash": {
          "$ref": "#/$defs/hash"
        }
      }
    },
    "temporalAuxiliaryCandidateSet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_set_id",
        "source_layer",
        "source_stem",
        "source_basis_type",
        "source_basis_value",
        "context_id",
        "entity_ids",
        "selection_status",
        "method_candidates",
        "source_refs",
        "fact_hash",
        "computation_hash"
      ],
      "properties": {
        "candidate_set_id": {
          "type": "string",
          "minLength": 1
        },
        "source_layer": {
          "enum": [
            "DAXIAN",
            "ANNUAL",
            "MONTH"
          ]
        },
        "source_stem": {
          "enum": [
            "甲",
            "乙",
            "丙",
            "丁",
            "戊",
            "己",
            "庚",
            "辛",
            "壬",
            "癸"
          ]
        },
        "source_basis_type": {
          "enum": [
            "STEM",
            "BRANCH"
          ]
        },
        "source_basis_value": {
          "enum": [
            "甲",
            "乙",
            "丙",
            "丁",
            "戊",
            "己",
            "庚",
            "辛",
            "壬",
            "癸",
            "子",
            "丑",
            "寅",
            "卯",
            "辰",
            "巳",
            "午",
            "未",
            "申",
            "酉",
            "戌",
            "亥"
          ]
        },
        "context_id": {
          "type": "string",
          "minLength": 1
        },
        "entity_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "enum": [
              "STAR.TIANKUI",
              "STAR.TIANYUE",
              "STAR.TIANMA"
            ]
          }
        },
        "selection_status": {
          "enum": [
            "CANDIDATES_PRESERVED_NO_SELECTION",
            "CASE_METHOD_CANDIDATE_PRESERVED_NO_SELECTION"
          ]
        },
        "method_candidates": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/temporalAuxiliaryMethodCandidate"
          }
        },
        "source_refs": {
          "type": "array",
          "minItems": 5,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "fact_hash": {
          "$ref": "#/$defs/hash"
        },
        "computation_hash": {
          "$ref": "#/$defs/hash"
        }
      }
    },
    "daxian": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frame_id",
        "index",
        "nominal_age_start",
        "nominal_age_end",
        "absolute_year_start",
        "absolute_year_end",
        "active_address",
        "active_palace_ganzhi",
        "designation_overlay",
        "source_stem",
        "auxiliary_activations",
        "auxiliary_candidate_sets",
        "transformations",
        "source_refs"
      ],
      "properties": {
        "frame_id": {
          "type": "string"
        },
        "index": {
          "type": "integer",
          "minimum": 1
        },
        "nominal_age_start": {
          "type": "integer",
          "minimum": 1
        },
        "nominal_age_end": {
          "type": "integer",
          "minimum": 1
        },
        "absolute_year_start": {
          "type": "integer"
        },
        "absolute_year_end": {
          "type": "integer"
        },
        "active_address": {
          "$ref": "#/$defs/address"
        },
        "active_palace_ganzhi": {
          "type": "string"
        },
        "designation_overlay": {
          "type": "array",
          "minItems": 12,
          "maxItems": 12,
          "items": {
            "$ref": "#/$defs/designation"
          }
        },
        "source_stem": {
          "enum": [
            "甲",
            "乙",
            "丙",
            "丁",
            "戊",
            "己",
            "庚",
            "辛",
            "壬",
            "癸"
          ]
        },
        "auxiliary_activations": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {
            "$ref": "#/$defs/temporalAuxiliaryActivation"
          }
        },
        "auxiliary_candidate_sets": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/temporalAuxiliaryCandidateSet"
          }
        },
        "transformations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/transformation"
          }
        },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "annual": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frame_id",
        "absolute_year",
        "nominal_age",
        "year_stem",
        "year_branch",
        "active_address",
        "active_palace_ganzhi",
        "doujun_address",
        "doujun_rule_id",
        "designation_overlay",
        "parent_daxian_frame_id",
        "auxiliary_activations",
        "auxiliary_candidate_sets",
        "transformations",
        "source_refs"
      ],
      "properties": {
        "frame_id": {
          "type": "string"
        },
        "absolute_year": {
          "type": "integer"
        },
        "nominal_age": {
          "type": "integer",
          "minimum": 1
        },
        "year_stem": {
          "enum": [
            "甲",
            "乙",
            "丙",
            "丁",
            "戊",
            "己",
            "庚",
            "辛",
            "壬",
            "癸"
          ]
        },
        "year_branch": {
          "enum": [
            "子",
            "丑",
            "寅",
            "卯",
            "辰",
            "巳",
            "午",
            "未",
            "申",
            "酉",
            "戌",
            "亥"
          ]
        },
        "active_address": {
          "$ref": "#/$defs/address"
        },
        "active_palace_ganzhi": {
          "type": "string"
        },
        "doujun_address": {
          "$ref": "#/$defs/address"
        },
        "doujun_rule_id": {
          "const": "S10-SUIJIAN-REVERSE-BIRTH-MONTH-FORWARD-BIRTH-HOUR-R1"
        },
        "designation_overlay": {
          "type": "array",
          "minItems": 12,
          "maxItems": 12,
          "items": {
            "$ref": "#/$defs/designation"
          }
        },
        "parent_daxian_frame_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "auxiliary_activations": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {
            "$ref": "#/$defs/temporalAuxiliaryActivation"
          }
        },
        "auxiliary_candidate_sets": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/temporalAuxiliaryCandidateSet"
          }
        },
        "transformations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/transformation"
          }
        },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "monthly": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frame_id",
        "absolute_year",
        "lunar_month",
        "month_stem",
        "month_branch",
        "month_ganzhi",
        "active_address",
        "designation_overlay",
        "parent_annual_frame_id",
        "monthly_rule_id",
        "month_ganzhi_rule_id",
        "calendar_scope",
        "leap_month_policy_status",
        "auxiliary_activations",
        "auxiliary_candidate_sets",
        "transformations",
        "source_refs"
      ],
      "properties": {
        "frame_id": {
          "type": "string"
        },
        "absolute_year": {
          "type": "integer"
        },
        "lunar_month": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        },
        "month_stem": {
          "enum": [
            "甲",
            "乙",
            "丙",
            "丁",
            "戊",
            "己",
            "庚",
            "辛",
            "壬",
            "癸"
          ]
        },
        "month_branch": {
          "enum": [
            "子",
            "丑",
            "寅",
            "卯",
            "辰",
            "巳",
            "午",
            "未",
            "申",
            "酉",
            "戌",
            "亥"
          ]
        },
        "month_ganzhi": {
          "type": "string",
          "minLength": 2,
          "maxLength": 2
        },
        "active_address": {
          "$ref": "#/$defs/address"
        },
        "designation_overlay": {
          "type": "array",
          "minItems": 12,
          "maxItems": 12,
          "items": {
            "$ref": "#/$defs/designation"
          }
        },
        "parent_annual_frame_id": {
          "type": "string"
        },
        "monthly_rule_id": {
          "const": "S10-DOUJUN-FIRST-MONTH-FORWARD-TWELVE-R1"
        },
        "month_ganzhi_rule_id": {
          "const": "FIVE-TIGERS-YEAR-STEM-MONTH-GANZHI-R1"
        },
        "calendar_scope": {
          "const": "REGULAR_LUNAR_MONTH_COORDINATE"
        },
        "leap_month_policy_status": {
          "const": "UNRESOLVED_NOT_GENERATED"
        },
        "auxiliary_activations": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {
            "$ref": "#/$defs/temporalAuxiliaryActivation"
          }
        },
        "auxiliary_candidate_sets": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "$ref": "#/$defs/temporalAuxiliaryCandidateSet"
          }
        },
        "transformations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/transformation"
          }
        },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "minor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frame_id",
        "nominal_age",
        "active_address",
        "source_refs"
      ],
      "properties": {
        "frame_id": {
          "type": "string"
        },
        "nominal_age": {
          "type": "integer",
          "minimum": 1
        },
        "active_address": {
          "$ref": "#/$defs/address"
        },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
