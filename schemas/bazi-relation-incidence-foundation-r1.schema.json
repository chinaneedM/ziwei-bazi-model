{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/chinaneedM/ziwei-bazi-model/schemas/bazi-relation-incidence-foundation-r1.schema.json",
  "title": "Bazi Relation Incidence Foundation R1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "typed_schema", "status", "upstream_natal_fact_hash",
    "target_utc", "incidence_profile", "candidate_counts", "candidates",
    "events", "diagnostics"
  ],
  "properties": {
    "schema": {"const": "BAZI-RELATION-INCIDENCE-FOUNDATION-RESULT-V1"},
    "typed_schema": {"const": "BAZI-RELATION-INCIDENCE-TYPED-RESOLUTION-V1"},
    "status": {"enum": ["RESOLVED", "MULTI_CANDIDATE", "FAILED"]},
    "upstream_natal_fact_hash": {"$ref": "#/$defs/hash"},
    "target_utc": {"type": "string", "format": "date-time"},
    "incidence_profile": {"$ref": "#/$defs/profile"},
    "candidate_counts": {"$ref": "#/$defs/candidateCounts"},
    "candidates": {"type": "array", "items": {"$ref": "#/$defs/candidate"}},
    "events": {"type": "array", "items": {"type": "string"}},
    "diagnostics": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "sourceRefs": {
      "type": "array", "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "ids": {
      "type": "array", "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "indices": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "integer", "minimum": 0}
    },
    "seedIds": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^BAZI-TEMPORAL-SEED:[0-9a-f]{64}$"}
    },
    "candidateCounts": {
      "type": "object", "additionalProperties": false,
      "required": ["flow", "structural", "support"],
      "properties": {
        "flow": {"type": "integer", "minimum": 0},
        "structural": {"type": "integer", "minimum": 0},
        "support": {"type": "integer", "minimum": 0}
      }
    },
    "profile": {
      "type": "object", "additionalProperties": false,
      "required": [
        "profile_id", "profile_version", "algorithm_id", "algorithm_version",
        "snapshot_rule_set_id", "snapshot_rule_set_version",
        "occurrence_reference_rule_set_id", "occurrence_reference_rule_set_version",
        "participant_incidence_rule_set_id", "participant_incidence_rule_set_version",
        "pair_topology_rule_set_id", "pair_topology_rule_set_version",
        "support_touch_rule_set_id", "support_touch_rule_set_version",
        "candidate_pairing_rule_set_id", "candidate_pairing_rule_set_version"
      ],
      "properties": {
        "profile_id": {"const": "BAZI-RELATION-INCIDENCE-FOUNDATION-R1"},
        "profile_version": {"const": "1.0.0"},
        "algorithm_id": {"const": "BAZI-RELATION-INCIDENCE-ENGINE-V1"},
        "algorithm_version": {"const": "1.0.0"},
        "snapshot_rule_set_id": {"const": "BAZI-RELATION-INCIDENCE-SNAPSHOT-R1"},
        "snapshot_rule_set_version": {"const": "1.0.0"},
        "occurrence_reference_rule_set_id": {"const": "BAZI-RELEASED-RELATION-OCCURRENCE-REFERENCE-R1"},
        "occurrence_reference_rule_set_version": {"const": "1.0.0"},
        "participant_incidence_rule_set_id": {"const": "BAZI-PARTICIPANT-RELATION-INCIDENCE-R1"},
        "participant_incidence_rule_set_version": {"const": "1.0.0"},
        "pair_topology_rule_set_id": {"const": "BAZI-EXACT-RELATION-PAIR-TOPOLOGY-R1"},
        "pair_topology_rule_set_version": {"const": "1.0.0"},
        "support_touch_rule_set_id": {"const": "BAZI-EXACT-SUPPORT-TOUCH-R1"},
        "support_touch_rule_set_version": {"const": "1.0.0"},
        "candidate_pairing_rule_set_id": {"const": "BAZI-INCIDENCE-LINEAGE-PAIRING-R1"},
        "candidate_pairing_rule_set_version": {"const": "1.0.0"}
      }
    },
    "participantReference": {
      "type": "object", "additionalProperties": false,
      "required": [
        "instance_id", "participant_kind", "value", "participant_layer",
        "source_frame_id", "source_upstream_fact_hash", "source_ganzhi"
      ],
      "properties": {
        "instance_id": {"type": "string", "minLength": 1},
        "participant_kind": {"enum": ["STEM", "BRANCH"]},
        "value": {"type": "string", "minLength": 1, "maxLength": 1},
        "participant_layer": {"enum": ["NATAL", "DAYUN", "ANNUAL", "MONTHLY"]},
        "source_frame_id": {"type": ["string", "null"]},
        "source_upstream_fact_hash": {"$ref": "#/$defs/hash"},
        "source_ganzhi": {"type": ["string", "null"], "minLength": 2, "maxLength": 2}
      }
    },
    "snapshot": {
      "type": "object", "additionalProperties": false,
      "required": [
        "snapshot_id", "snapshot_fact_hash", "target_utc",
        "upstream_natal_fact_hash", "upstream_natal_computation_hash",
        "upstream_temporal_fact_hash", "source_temporal_candidate_indices",
        "source_temporal_seed_ids", "upstream_flow_fact_hash",
        "upstream_flow_computation_hash", "upstream_structural_fact_hash",
        "upstream_structural_computation_hash", "upstream_support_fact_hash",
        "upstream_support_computation_hash", "active_dayun_kind",
        "active_dayun_source_frame_id", "annual_frame_id", "monthly_frame_id",
        "raw_relation_ids", "rule_set_id", "rule_set_version", "source_refs"
      ],
      "properties": {
        "snapshot_id": {"type": "string", "pattern": "^RELATION_INCIDENCE_SNAPSHOT:[0-9a-f]{64}$"},
        "snapshot_fact_hash": {"$ref": "#/$defs/hash"},
        "target_utc": {"type": "string", "format": "date-time"},
        "upstream_natal_fact_hash": {"$ref": "#/$defs/hash"},
        "upstream_natal_computation_hash": {"$ref": "#/$defs/hash"},
        "upstream_temporal_fact_hash": {"$ref": "#/$defs/hash"},
        "source_temporal_candidate_indices": {"$ref": "#/$defs/indices"},
        "source_temporal_seed_ids": {"$ref": "#/$defs/seedIds"},
        "upstream_flow_fact_hash": {"$ref": "#/$defs/hash"},
        "upstream_flow_computation_hash": {"$ref": "#/$defs/hash"},
        "upstream_structural_fact_hash": {"$ref": "#/$defs/hash"},
        "upstream_structural_computation_hash": {"$ref": "#/$defs/hash"},
        "upstream_support_fact_hash": {"$ref": "#/$defs/hash"},
        "upstream_support_computation_hash": {"$ref": "#/$defs/hash"},
        "active_dayun_kind": {"enum": ["PRE_DAYUN", "DAYUN"]},
        "active_dayun_source_frame_id": {"type": "string", "minLength": 1},
        "annual_frame_id": {"type": "string", "pattern": "^ANNUAL:"},
        "monthly_frame_id": {"type": "string", "pattern": "^MONTHLY:"},
        "raw_relation_ids": {"$ref": "#/$defs/ids"},
        "rule_set_id": {"const": "BAZI-RELATION-INCIDENCE-SNAPSHOT-R1"},
        "rule_set_version": {"const": "1.0.0"},
        "source_refs": {"$ref": "#/$defs/sourceRefs"}
      }
    },
    "relationOccurrence": {
      "type": "object", "additionalProperties": false,
      "required": [
        "reference_id", "relation_id", "semantic_relation_id", "relation_type",
        "relation_family", "participant_instance_ids", "participant_layers",
        "participant_provenance", "relation_scope", "orientation", "arity",
        "nominal_transformation_element", "nominal_transformation_semantics",
        "source_occurrence_kind", "source_upstream_fact_hash",
        "source_relation_rule_set_id", "source_relation_rule_set_version",
        "reference_rule_set_id", "reference_rule_set_version", "source_refs"
      ],
      "properties": {
        "reference_id": {"type": "string", "pattern": "^RELATION_OCCURRENCE_REFERENCE:"},
        "relation_id": {"type": "string", "minLength": 1},
        "semantic_relation_id": {"type": "string", "minLength": 1},
        "relation_type": {"enum": [
          "STEM_FIVE_COMBINATION", "BRANCH_LIUHE", "BRANCH_CHONG",
          "BRANCH_SANHE_COMPLETE", "BRANCH_ZIMAO_PUNISHMENT",
          "BRANCH_DIRECTIONAL_PUNISHMENT", "BRANCH_SELF_PUNISHMENT"
        ]},
        "relation_family": {"enum": [
          "STEM_COMBINATION", "BRANCH_SIX_HARMONY", "BRANCH_CLASH",
          "BRANCH_PUNISHMENT", "BRANCH_TRINE"
        ]},
        "participant_instance_ids": {
          "type": "array", "minItems": 2, "maxItems": 3,
          "items": {"type": "string", "minLength": 1}
        },
        "participant_layers": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"enum": ["NATAL", "DAYUN", "ANNUAL", "MONTHLY"]}
        },
        "participant_provenance": {
          "type": "array", "minItems": 2, "maxItems": 3,
          "items": {"$ref": "#/$defs/participantReference"}
        },
        "relation_scope": {"enum": ["NATAL_ONLY", "CROSS_LAYER", "TEMPORAL_ONLY"]},
        "orientation": {"enum": ["SYMMETRIC", "DIRECTED", "SELF", "GROUP"]},
        "arity": {"enum": [2, 3]},
        "nominal_transformation_element": {"type": ["string", "null"]},
        "nominal_transformation_semantics": {
          "type": ["string", "null"],
          "enum": [null, "NOMINAL_TARGET_ONLY_NOT_TRANSFORMATION_SUCCESS"]
        },
        "source_occurrence_kind": {"enum": ["NATAL_RELATION_CANDIDATE", "STRUCTURAL_DYNAMIC_RELATION_OCCURRENCE"]},
        "source_upstream_fact_hash": {"$ref": "#/$defs/hash"},
        "source_relation_rule_set_id": {"type": "string", "minLength": 1},
        "source_relation_rule_set_version": {"type": "string", "minLength": 1},
        "reference_rule_set_id": {"const": "BAZI-RELEASED-RELATION-OCCURRENCE-REFERENCE-R1"},
        "reference_rule_set_version": {"const": "1.0.0"},
        "source_refs": {"$ref": "#/$defs/sourceRefs"}
      }
    },
    "participantIncidence": {
      "type": "object", "additionalProperties": false,
      "required": [
        "incidence_fact_id", "participant_instance_id", "participant_kind", "value",
        "participant_layer", "source_frame_id", "source_ganzhi", "relation_ids",
        "relation_count", "support_evidence_candidate_ids", "seasonal_role_ids",
        "seasonal_role_reference_ids", "source_participant_fact_hash",
        "source_relation_fact_hashes", "source_support_fact_hash", "snapshot_id",
        "snapshot_fact_hash", "rule_set_id", "rule_set_version",
        "support_touch_rule_set_id", "support_touch_rule_set_version", "source_refs"
      ],
      "properties": {
        "incidence_fact_id": {"type": "string", "pattern": "^PARTICIPANT_RELATION_INCIDENCE:[0-9a-f]{64}$"},
        "participant_instance_id": {"type": "string", "minLength": 1},
        "participant_kind": {"enum": ["STEM", "BRANCH"]},
        "value": {"type": "string", "minLength": 1, "maxLength": 1},
        "participant_layer": {"enum": ["NATAL", "DAYUN", "ANNUAL", "MONTHLY"]},
        "source_frame_id": {"type": ["string", "null"]},
        "source_ganzhi": {"type": ["string", "null"], "minLength": 2, "maxLength": 2},
        "relation_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "relation_count": {"type": "integer", "minimum": 1},
        "support_evidence_candidate_ids": {"$ref": "#/$defs/ids"},
        "seasonal_role_ids": {
          "type": "array", "uniqueItems": true,
          "items": {"enum": ["NATAL_MONTH_COMMAND", "ACTIVE_FLOW_SOLAR_MONTH"]}
        },
        "seasonal_role_reference_ids": {"$ref": "#/$defs/ids"},
        "source_participant_fact_hash": {"$ref": "#/$defs/hash"},
        "source_relation_fact_hashes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/hash"}},
        "source_support_fact_hash": {"$ref": "#/$defs/hash"},
        "snapshot_id": {"type": "string", "pattern": "^RELATION_INCIDENCE_SNAPSHOT:"},
        "snapshot_fact_hash": {"$ref": "#/$defs/hash"},
        "rule_set_id": {"const": "BAZI-PARTICIPANT-RELATION-INCIDENCE-R1"},
        "rule_set_version": {"const": "1.0.0"},
        "support_touch_rule_set_id": {"const": "BAZI-EXACT-SUPPORT-TOUCH-R1"},
        "support_touch_rule_set_version": {"const": "1.0.0"},
        "source_refs": {"$ref": "#/$defs/sourceRefs"}
      }
    },
    "pairTopology": {
      "type": "object", "additionalProperties": false,
      "required": [
        "pair_fact_id", "relation_ids", "topology_kind",
        "shared_participant_instance_ids", "left_only_participant_instance_ids",
        "right_only_participant_instance_ids", "participant_layer_provenance",
        "source_snapshot_id", "source_snapshot_fact_hash", "profile_id",
        "profile_version", "rule_set_id", "rule_set_version", "source_refs"
      ],
      "properties": {
        "pair_fact_id": {"type": "string", "pattern": "^RELATION_PAIR_TOPOLOGY:[0-9a-f]{64}$"},
        "relation_ids": {
          "type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "topology_kind": {"enum": ["SHARED_PARTICIPANT", "DISJOINT"]},
        "shared_participant_instance_ids": {"$ref": "#/$defs/ids"},
        "left_only_participant_instance_ids": {"$ref": "#/$defs/ids"},
        "right_only_participant_instance_ids": {"$ref": "#/$defs/ids"},
        "participant_layer_provenance": {
          "type": "array", "minItems": 2, "maxItems": 6,
          "items": {"$ref": "#/$defs/participantReference"}
        },
        "source_snapshot_id": {"type": "string", "pattern": "^RELATION_INCIDENCE_SNAPSHOT:"},
        "source_snapshot_fact_hash": {"$ref": "#/$defs/hash"},
        "profile_id": {"const": "BAZI-RELATION-INCIDENCE-FOUNDATION-R1"},
        "profile_version": {"const": "1.0.0"},
        "rule_set_id": {"const": "BAZI-EXACT-RELATION-PAIR-TOPOLOGY-R1"},
        "rule_set_version": {"const": "1.0.0"},
        "source_refs": {"$ref": "#/$defs/sourceRefs"}
      }
    },
    "context": {
      "type": "object", "additionalProperties": false,
      "required": [
        "snapshot", "relation_occurrences", "participant_incidence_facts",
        "relation_pair_topology_facts", "profile_id", "profile_version",
        "algorithm_versions"
      ],
      "properties": {
        "snapshot": {"$ref": "#/$defs/snapshot"},
        "relation_occurrences": {"type": "array", "items": {"$ref": "#/$defs/relationOccurrence"}},
        "participant_incidence_facts": {"type": "array", "items": {"$ref": "#/$defs/participantIncidence"}},
        "relation_pair_topology_facts": {"type": "array", "items": {"$ref": "#/$defs/pairTopology"}},
        "profile_id": {"const": "BAZI-RELATION-INCIDENCE-FOUNDATION-R1"},
        "profile_version": {"const": "1.0.0"},
        "algorithm_versions": {
          "type": "object", "additionalProperties": false,
          "required": [
            "incidence", "snapshot", "occurrence_reference",
            "participant_incidence", "pair_topology", "support_touch",
            "candidate_pairing"
          ],
          "properties": {
            "incidence": {"const": "1.0.0"},
            "snapshot": {"const": "1.0.0"},
            "occurrence_reference": {"const": "1.0.0"},
            "participant_incidence": {"const": "1.0.0"},
            "pair_topology": {"const": "1.0.0"},
            "support_touch": {"const": "1.0.0"},
            "candidate_pairing": {"const": "1.0.0"}
          }
        }
      }
    },
    "diagnostic": {
      "type": "object", "additionalProperties": false,
      "required": ["code", "path", "detail"],
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "path": {"type": "string"},
        "detail": {"type": "string"}
      }
    },
    "integrity": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "diagnostics", "algorithm_id", "algorithm_version"],
      "properties": {
        "status": {"enum": ["PASS", "FAIL"]},
        "diagnostics": {"type": "array", "items": {"$ref": "#/$defs/diagnostic"}},
        "algorithm_id": {"const": "BAZI-RELATION-INCIDENCE-INTEGRITY-V1"},
        "algorithm_version": {"const": "1.0.0"}
      }
    },
    "hashes": {
      "type": "object", "additionalProperties": false,
      "required": ["fact_hash", "computation_hash", "algorithm_id", "algorithm_version"],
      "properties": {
        "fact_hash": {"$ref": "#/$defs/hash"},
        "computation_hash": {"$ref": "#/$defs/hash"},
        "algorithm_id": {"const": "BAZI-RELATION-INCIDENCE-HASH-V1"},
        "algorithm_version": {"const": "1.0.0"}
      }
    },
    "candidate": {
      "type": "object", "additionalProperties": false,
      "required": [
        "source_flow_candidate_indices", "source_structural_candidate_indices",
        "source_support_candidate_indices", "source_temporal_candidate_indices",
        "source_temporal_seed_ids", "lineage_binding_keys", "context",
        "integrity", "hashes"
      ],
      "properties": {
        "source_flow_candidate_indices": {"$ref": "#/$defs/indices"},
        "source_structural_candidate_indices": {"$ref": "#/$defs/indices"},
        "source_support_candidate_indices": {"$ref": "#/$defs/indices"},
        "source_temporal_candidate_indices": {"$ref": "#/$defs/indices"},
        "source_temporal_seed_ids": {"$ref": "#/$defs/seedIds"},
        "lineage_binding_keys": {"type": "array", "minItems": 6, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "context": {"$ref": "#/$defs/context"},
        "integrity": {"$ref": "#/$defs/integrity"},
        "hashes": {"$ref": "#/$defs/hashes"}
      }
    }
  }
}
