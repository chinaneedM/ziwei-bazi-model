{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/chinaneedM/ziwei-bazi-model/schemas/bazi-application-flow-integration-r1.schema.json",
  "title": "Bazi Application Flow Integration R1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "status", "base_application_bundle_hash", "base_application_source_fact_hash",
    "application_profile_id", "application_profile_version", "natal_profile_id", "natal_profile_version",
    "temporal_profile_id", "temporal_profile_version", "target_coordinate_profile_id",
    "target_coordinate_profile_version", "dayun_count", "target_input", "target_coordinate_status",
    "target_coordinate_effective_uncertainty_seconds_each_side", "target_coordinate_sample_count",
    "target_coordinate_ambiguous_sample_count", "target_coordinate_unresolved_samples",
    "target_coordinate_fact_hash", "target_coordinate_computation_hash", "candidates", "events",
    "diagnostics", "source_fact_hash", "view_hash", "bundle_hash", "integrity"
  ],
  "properties": {
    "schema": {"const": "BAZI-APPLICATION-FLOW-RESOLUTION-R1"},
    "status": {"enum": ["RESOLVED", "MULTI_CANDIDATE"]},
    "base_application_bundle_hash": {"$ref": "#/$defs/hash"},
    "base_application_source_fact_hash": {"$ref": "#/$defs/hash"},
    "application_profile_id": {"type": "string", "minLength": 1},
    "application_profile_version": {"type": "string", "minLength": 1},
    "natal_profile_id": {"type": "string", "minLength": 1},
    "natal_profile_version": {"type": "string", "minLength": 1},
    "temporal_profile_id": {"type": "string", "minLength": 1},
    "temporal_profile_version": {"type": "string", "minLength": 1},
    "target_coordinate_profile_id": {"const": "BAZI-TARGET-TEMPORAL-COORDINATE-FOUNDATION-R1"},
    "target_coordinate_profile_version": {"const": "1.0.0"},
    "dayun_count": {"type": "integer", "minimum": 1, "maximum": 20},
    "target_input": {"$ref": "#/$defs/targetInput"},
    "target_coordinate_status": {"enum": ["RESOLVED", "MULTI_CANDIDATE_OR_BOUNDARY_UNCERTAINTY"]},
    "target_coordinate_effective_uncertainty_seconds_each_side": {"type": "integer", "minimum": 0},
    "target_coordinate_sample_count": {"type": "integer", "minimum": 1},
    "target_coordinate_ambiguous_sample_count": {"type": "integer", "minimum": 0},
    "target_coordinate_unresolved_samples": {"type": "array", "items": {"$ref": "#/$defs/unresolvedSample"}},
    "target_coordinate_fact_hash": {"$ref": "#/$defs/hash"},
    "target_coordinate_computation_hash": {"$ref": "#/$defs/hash"},
    "candidates": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/candidate"}},
    "events": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "diagnostics": {"type": "array", "maxItems": 0},
    "source_fact_hash": {"$ref": "#/$defs/hash"},
    "view_hash": {"$ref": "#/$defs/hash"},
    "bundle_hash": {"$ref": "#/$defs/hash"},
    "integrity": {"$ref": "#/$defs/integrity"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "targetCandidateId": {"type": "string", "pattern": "^BAZI-TARGET-TEMPORAL-CANDIDATE:[0-9a-f]{64}$"},
    "applicationCandidateId": {"type": "string", "pattern": "^BAZI-APPLICATION-CANDIDATE:[0-9a-f]{64}$"},
    "targetInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reported_local_datetime", "target_place", "latitude", "longitude", "timezone_id", "precision", "uncertainty_seconds"],
      "properties": {
        "reported_local_datetime": {"type": "string"},
        "target_place": {"type": "string", "minLength": 1},
        "latitude": {"type": "number", "minimum": -90, "maximum": 90},
        "longitude": {"type": "number", "minimum": -180, "maximum": 180},
        "timezone_id": {"type": "string", "minLength": 1},
        "precision": {"enum": ["EXACT_SECOND", "NEAREST_MINUTE", "NEAREST_HOUR", "APPROXIMATE"]},
        "uncertainty_seconds": {"type": "integer", "minimum": 0}
      }
    },
    "unresolvedSample": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_sample_index", "sample_reported_local_datetime", "civil_status", "timezone_id", "tzdb_version", "historical_confidence", "warnings"],
      "properties": {
        "source_sample_index": {"type": "integer", "minimum": 0},
        "sample_reported_local_datetime": {"type": "string"},
        "civil_status": {"type": "string", "minLength": 1},
        "timezone_id": {"type": "string", "minLength": 1},
        "tzdb_version": {"type": "string", "minLength": 1},
        "historical_confidence": {"type": "string", "minLength": 1},
        "warnings": {"type": "array", "items": {"type": "string"}}
      }
    },
    "activePreDayun": {
      "type": "object",
      "additionalProperties": false,
      "required": ["frame_id", "start_utc", "end_utc", "interval_semantics"],
      "properties": {
        "frame_id": {"type": "string", "minLength": 1},
        "start_utc": {"type": "string"},
        "end_utc": {"type": "string"},
        "interval_semantics": {"const": "START_INCLUSIVE_END_EXCLUSIVE"}
      }
    },
    "activeDayun": {
      "type": "object",
      "additionalProperties": false,
      "required": ["frame_id", "index", "ganzhi", "sexagenary_index", "start_utc", "end_utc", "interval_semantics", "source_refs"],
      "properties": {
        "frame_id": {"type": "string", "minLength": 1},
        "index": {"type": "integer", "minimum": 1},
        "ganzhi": {"type": "string", "minLength": 2, "maxLength": 2},
        "sexagenary_index": {"type": "integer", "minimum": 0, "maximum": 59},
        "start_utc": {"type": "string"},
        "end_utc": {"type": "string"},
        "interval_semantics": {"const": "START_INCLUSIVE_END_EXCLUSIVE"},
        "source_refs": {"type": "array", "items": {"type": "string"}}
      }
    },
    "annual": {
      "type": "object",
      "additionalProperties": false,
      "required": ["frame_id", "pillar_year", "ganzhi", "sexagenary_index", "start_term_name", "start_term_chinese_name", "start_utc", "end_term_name", "end_term_chinese_name", "end_utc", "interval_semantics", "year_boundary_policy", "solar_term_algorithm_id", "solar_term_algorithm_version", "source_refs"],
      "properties": {
        "frame_id": {"type": "string", "minLength": 1},
        "pillar_year": {"type": "integer"},
        "ganzhi": {"type": "string", "minLength": 2, "maxLength": 2},
        "sexagenary_index": {"type": "integer", "minimum": 0, "maximum": 59},
        "start_term_name": {"type": "string"},
        "start_term_chinese_name": {"type": "string"},
        "start_utc": {"type": "string"},
        "end_term_name": {"type": "string"},
        "end_term_chinese_name": {"type": "string"},
        "end_utc": {"type": "string"},
        "interval_semantics": {"const": "START_INCLUSIVE_END_EXCLUSIVE"},
        "year_boundary_policy": {"const": "START_OF_SPRING"},
        "solar_term_algorithm_id": {"type": "string"},
        "solar_term_algorithm_version": {"type": "string"},
        "source_refs": {"type": "array", "items": {"type": "string"}}
      }
    },
    "monthly": {
      "type": "object",
      "additionalProperties": false,
      "required": ["frame_id", "ganzhi", "sexagenary_index", "start_jie_name", "start_jie_chinese_name", "start_jie_longitude_degrees", "start_utc", "end_jie_name", "end_jie_chinese_name", "end_jie_longitude_degrees", "end_utc", "interval_semantics", "solar_term_algorithm_id", "solar_term_algorithm_version", "source_refs"],
      "properties": {
        "frame_id": {"type": "string", "minLength": 1},
        "ganzhi": {"type": "string", "minLength": 2, "maxLength": 2},
        "sexagenary_index": {"type": "integer", "minimum": 0, "maximum": 59},
        "start_jie_name": {"type": "string"},
        "start_jie_chinese_name": {"type": "string"},
        "start_jie_longitude_degrees": {"type": "integer"},
        "start_utc": {"type": "string"},
        "end_jie_name": {"type": "string"},
        "end_jie_chinese_name": {"type": "string"},
        "end_jie_longitude_degrees": {"type": "integer"},
        "end_utc": {"type": "string"},
        "interval_semantics": {"const": "START_INCLUSIVE_END_EXCLUSIVE"},
        "solar_term_algorithm_id": {"type": "string"},
        "solar_term_algorithm_version": {"type": "string"},
        "source_refs": {"type": "array", "items": {"type": "string"}}
      }
    },
    "daily": {
      "type": "object",
      "additionalProperties": false,
      "required": ["frame_id", "ganzhi", "sexagenary_index", "effective_day_date", "start_las", "end_las", "interval_semantics", "day_boundary_policy", "source_flow_fact_hash", "source_target_coordinate_fact_hash", "source_target_coordinate_candidate_id", "natal_profile_id", "natal_profile_version"],
      "properties": {
        "frame_id": {"type": "string", "pattern": "^DAILY:[0-9a-f]{64}$"},
        "ganzhi": {"type": "string", "minLength": 2, "maxLength": 2},
        "sexagenary_index": {"type": "integer", "minimum": 0, "maximum": 59},
        "effective_day_date": {"type": "string"},
        "start_las": {"type": "string"},
        "end_las": {"type": "string"},
        "interval_semantics": {"const": "START_INCLUSIVE_END_EXCLUSIVE"},
        "day_boundary_policy": {"enum": ["MIDNIGHT", "ZI_START_23"]},
        "source_flow_fact_hash": {"$ref": "#/$defs/hash"},
        "source_target_coordinate_fact_hash": {"$ref": "#/$defs/hash"},
        "source_target_coordinate_candidate_id": {"$ref": "#/$defs/targetCandidateId"},
        "natal_profile_id": {"type": "string"},
        "natal_profile_version": {"type": "string"}
      }
    },
    "hourly": {
      "type": "object",
      "additionalProperties": false,
      "required": ["frame_id", "ganzhi", "sexagenary_index", "branch", "start_las", "end_las", "interval_semantics", "hour_stem_source_date", "late_zi_hour_stem_policy", "daily_frame_id", "source_flow_fact_hash", "source_target_coordinate_fact_hash", "source_target_coordinate_candidate_id", "natal_profile_id", "natal_profile_version"],
      "properties": {
        "frame_id": {"type": "string", "pattern": "^HOURLY:[0-9a-f]{64}$"},
        "ganzhi": {"type": "string", "minLength": 2, "maxLength": 2},
        "sexagenary_index": {"type": "integer", "minimum": 0, "maximum": 59},
        "branch": {"type": "string", "minLength": 1, "maxLength": 1},
        "start_las": {"type": "string"},
        "end_las": {"type": "string"},
        "interval_semantics": {"const": "START_INCLUSIVE_END_EXCLUSIVE"},
        "hour_stem_source_date": {"type": "string"},
        "late_zi_hour_stem_policy": {"enum": ["CLASSICAL_CONTINUOUS", "CURRENT_DAY_STEM", "ZI_START_ROLLOVER"]},
        "daily_frame_id": {"type": "string", "pattern": "^DAILY:[0-9a-f]{64}$"},
        "source_flow_fact_hash": {"$ref": "#/$defs/hash"},
        "source_target_coordinate_fact_hash": {"$ref": "#/$defs/hash"},
        "source_target_coordinate_candidate_id": {"$ref": "#/$defs/targetCandidateId"},
        "natal_profile_id": {"type": "string"},
        "natal_profile_version": {"type": "string"}
      }
    },
    "temporalHiddenStem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stem", "element", "registry_ordinal", "ten_god_semantic_role_id", "ten_god"],
      "properties": {
        "stem": {"type": "string", "minLength": 1, "maxLength": 1},
        "element": {"enum": ["木", "火", "土", "金", "水"]},
        "registry_ordinal": {"type": "integer", "minimum": 0, "maximum": 2},
        "ten_god_semantic_role_id": {"enum": ["BIJIAN", "JIECAI", "SHISHEN", "SHANGGUAN", "PIANCAI", "ZHENGCAI", "QISHA", "ZHENGGUAN", "PIANIN", "ZHENGIN"]},
        "ten_god": {"type": "string", "minLength": 1}
      }
    },
    "temporalGrowth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_id", "profile_version", "source_stem", "target_branch", "stem_polarity", "direction", "growth_start_branch", "phase_ordinal", "phase", "source_refs", "semantic_scope"],
      "properties": {
        "profile_id": {"const": "BAZI-TWELVE-GROWTH-YIN-YANG-R1"},
        "profile_version": {"const": "1.0.0"},
        "source_stem": {"type": "string", "minLength": 1, "maxLength": 1},
        "target_branch": {"type": "string", "minLength": 1, "maxLength": 1},
        "stem_polarity": {"enum": ["YANG", "YIN"]},
        "direction": {"enum": ["FORWARD", "REVERSE"]},
        "growth_start_branch": {"type": "string", "minLength": 1, "maxLength": 1},
        "phase_ordinal": {"type": "integer", "minimum": 0, "maximum": 11},
        "phase": {"enum": ["长生", "沐浴", "冠带", "临官", "帝旺", "衰", "病", "死", "墓", "绝", "胎", "养"]},
        "source_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "semantic_scope": {"const": "PHASE_IDENTITY_ONLY_NO_STRENGTH_CONCLUSION"}
      }
    },
    "temporalAnnotation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_id", "profile_version", "source_layer", "context_id", "day_master_stem", "ganzhi", "sexagenary_index", "stem", "branch", "visible_ten_god", "hidden_stems", "nayin", "xunkong", "day_master_twelve_growth", "self_twelve_growth", "rule_bindings", "semantic_scope", "source_refs", "fact_hash", "computation_hash"],
      "properties": {
        "profile_id": {"const": "BAZI-TEMPORAL-CLASSICAL-ANNOTATION-PROJECTION-R1"},
        "profile_version": {"const": "1.0.0"},
        "source_layer": {"enum": ["DAYUN", "XIAOYUN", "ANNUAL", "MONTHLY", "DAILY", "HOURLY"]},
        "context_id": {"type": "string", "minLength": 1},
        "day_master_stem": {"type": "string", "minLength": 1, "maxLength": 1},
        "ganzhi": {"type": "string", "minLength": 2, "maxLength": 2},
        "sexagenary_index": {"type": "integer", "minimum": 0, "maximum": 59},
        "stem": {"type": "string", "minLength": 1, "maxLength": 1},
        "branch": {"type": "string", "minLength": 1, "maxLength": 1},
        "visible_ten_god": {
          "type": "object", "additionalProperties": false,
          "required": ["semantic_role_id", "display_name"],
          "properties": {
            "semantic_role_id": {"enum": ["BIJIAN", "JIECAI", "SHISHEN", "SHANGGUAN", "PIANCAI", "ZHENGCAI", "QISHA", "ZHENGGUAN", "PIANIN", "ZHENGIN"]},
            "display_name": {"type": "string", "minLength": 1}
          }
        },
        "hidden_stems": {"type": "array", "minItems": 1, "maxItems": 3, "items": {"$ref": "#/$defs/temporalHiddenStem"}},
        "nayin": {
          "type": "object", "additionalProperties": false,
          "required": ["profile_id", "profile_version", "registry_id", "registry_version", "semantic_id", "display_name", "element"],
          "properties": {
            "profile_id": {"const": "BAZI-NAYIN-ANNOTATION-R1"},
            "profile_version": {"const": "1.0.0"},
            "registry_id": {"const": "BAZI-NAYIN-REGISTRY-R1"},
            "registry_version": {"const": "1.0.0"},
            "semantic_id": {"type": "string", "pattern": "^NAYIN:PAIR:(0[0-9]|1[0-9]|2[0-9])$"},
            "display_name": {"type": "string", "minLength": 1},
            "element": {"enum": ["木", "火", "土", "金", "水"]}
          }
        },
        "xunkong": {
          "type": "object", "additionalProperties": false,
          "required": ["profile_id", "profile_version", "xun_index", "xun_start_ganzhi", "void_branches", "display_name", "source_refs", "semantic_scope"],
          "properties": {
            "profile_id": {"const": "BAZI-XUNKONG-YHZP-R1"},
            "profile_version": {"const": "1.0.0"},
            "xun_index": {"type": "integer", "minimum": 0, "maximum": 5},
            "xun_start_ganzhi": {"type": "string", "minLength": 2, "maxLength": 2},
            "void_branches": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "string", "minLength": 1, "maxLength": 1}},
            "display_name": {"type": "string", "minLength": 2, "maxLength": 2},
            "source_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
            "semantic_scope": {"const": "IDENTITY_ONLY_NO_AUSPICIOUSNESS"}
          }
        },
        "day_master_twelve_growth": {"$ref": "#/$defs/temporalGrowth"},
        "self_twelve_growth": {"$ref": "#/$defs/temporalGrowth"},
        "rule_bindings": {
          "type": "object", "additionalProperties": false,
          "required": ["hidden_stem_rule_set_id", "hidden_stem_rule_set_version", "ten_god_rule_set_id", "ten_god_rule_set_version", "ten_god_algorithm_id", "ten_god_algorithm_version", "nayin_algorithm_id", "nayin_algorithm_version", "xunkong_profile_id", "xunkong_profile_version", "twelve_growth_profile_id", "twelve_growth_profile_version"],
          "properties": {
            "hidden_stem_rule_set_id": {"const": "S11-STANDARD-HIDDEN-STEM-MEMBERSHIP-R1"},
            "hidden_stem_rule_set_version": {"const": "1.0.0"},
            "ten_god_rule_set_id": {"const": "S11-TEN-GOD-RELATION-R1"},
            "ten_god_rule_set_version": {"const": "1.0.0"},
            "ten_god_algorithm_id": {"const": "BAZI-TEN-GOD-GENERATOR-V1"},
            "ten_god_algorithm_version": {"const": "1.0.0"},
            "nayin_algorithm_id": {"const": "BAZI-NAYIN-ANNOTATION-R1"},
            "nayin_algorithm_version": {"const": "1.0.0"},
            "xunkong_profile_id": {"const": "BAZI-XUNKONG-YHZP-R1"},
            "xunkong_profile_version": {"const": "1.0.0"},
            "twelve_growth_profile_id": {"const": "BAZI-TWELVE-GROWTH-YIN-YANG-R1"},
            "twelve_growth_profile_version": {"const": "1.0.0"}
          }
        },
        "semantic_scope": {"const": "IDENTITY_ANNOTATIONS_ONLY_NO_STRENGTH_PATTERN_OR_INTERPRETATION"},
        "source_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "fact_hash": {"$ref": "#/$defs/hash"},
        "computation_hash": {"$ref": "#/$defs/hash"}
      }
    },
    "temporalAnnotationResolvedSlot": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "annotation"],
      "properties": {"status": {"const": "RESOLVED"}, "annotation": {"$ref": "#/$defs/temporalAnnotation"}}
    },
    "temporalAnnotationOptionalSlot": {
      "oneOf": [
        {"$ref": "#/$defs/temporalAnnotationResolvedSlot"},
        {
          "type": "object", "additionalProperties": false,
          "required": ["status", "annotation"],
          "properties": {
            "status": {"enum": ["PRE_DAYUN_NO_GANZHI_ANNOTATION", "OUTSIDE_MATERIALIZED_XIAOYUN_RANGE"]},
            "annotation": {"type": "null"}
          }
        }
      ]
    },
    "temporalAnnotationProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_id", "profile_version", "day_master_stem", "dayun", "xiaoyun_candidates", "annual", "monthly", "daily", "hourly", "selection_semantics", "semantic_scope", "source_refs", "fact_hash", "computation_hash"],
      "properties": {
        "profile_id": {"const": "BAZI-TEMPORAL-CLASSICAL-ANNOTATION-PROJECTION-R1"},
        "profile_version": {"const": "1.0.0"},
        "day_master_stem": {"type": "string", "minLength": 1, "maxLength": 1},
        "dayun": {"$ref": "#/$defs/temporalAnnotationOptionalSlot"},
        "xiaoyun_candidates": {
          "type": "array", "minItems": 2,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["profile_id", "direction", "status", "annotation"],
            "properties": {
              "profile_id": {"type": "string", "minLength": 1},
              "direction": {"enum": ["FORWARD", "REVERSE"]},
              "status": {"enum": ["RESOLVED", "OUTSIDE_MATERIALIZED_XIAOYUN_RANGE"]},
              "annotation": {"oneOf": [{"$ref": "#/$defs/temporalAnnotation"}, {"type": "null"}]}
            }
          }
        },
        "annual": {"$ref": "#/$defs/temporalAnnotationResolvedSlot"},
        "monthly": {"$ref": "#/$defs/temporalAnnotationResolvedSlot"},
        "daily": {"$ref": "#/$defs/temporalAnnotationResolvedSlot"},
        "hourly": {"$ref": "#/$defs/temporalAnnotationResolvedSlot"},
        "selection_semantics": {"const": "XIAOYUN_CANDIDATES_PRESERVED_NO_WINNER"},
        "semantic_scope": {"const": "IDENTITY_ANNOTATIONS_ONLY_NO_STRENGTH_PATTERN_OR_INTERPRETATION"},
        "source_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "fact_hash": {"$ref": "#/$defs/hash"},
        "computation_hash": {"$ref": "#/$defs/hash"}
      }
    },
    "targetView": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_place", "reported_local_datetime", "latitude", "longitude", "timezone_id", "precision", "uncertainty_seconds", "target_coordinate_candidate_index", "target_coordinate_candidate_id", "source_sample_index", "sample_reported_local_datetime", "civil_status", "fold", "utc_offset_seconds", "target_utc", "local_apparent_solar_datetime"],
      "properties": {
        "target_place": {"type": "string"},
        "reported_local_datetime": {"type": "string"},
        "latitude": {"type": "number", "minimum": -90, "maximum": 90},
        "longitude": {"type": "number", "minimum": -180, "maximum": 180},
        "timezone_id": {"type": "string"},
        "precision": {"enum": ["EXACT_SECOND", "NEAREST_MINUTE", "NEAREST_HOUR", "APPROXIMATE"]},
        "uncertainty_seconds": {"type": "integer", "minimum": 0},
        "target_coordinate_candidate_index": {"type": "integer", "minimum": 0},
        "target_coordinate_candidate_id": {"$ref": "#/$defs/targetCandidateId"},
        "source_sample_index": {"type": "integer", "minimum": 0},
        "sample_reported_local_datetime": {"type": "string"},
        "civil_status": {"type": "string"},
        "fold": {"type": "integer", "minimum": 0, "maximum": 1},
        "utc_offset_seconds": {"type": "integer"},
        "target_utc": {"type": "string"},
        "local_apparent_solar_datetime": {"type": "string"}
      }
    },
    "view": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "flow", "daily", "hourly", "timeline", "lineage", "integrity", "source_hashes"],
      "properties": {
        "target": {"$ref": "#/$defs/targetView"},
        "flow": {
          "type": "object",
          "additionalProperties": false,
          "required": ["active_dayun_kind", "active_dayun_frame", "annual", "monthly"],
          "properties": {
            "active_dayun_kind": {"enum": ["PRE_DAYUN", "DAYUN"]},
            "active_dayun_frame": {"oneOf": [{"$ref": "#/$defs/activePreDayun"}, {"$ref": "#/$defs/activeDayun"}]},
            "annual": {"$ref": "#/$defs/annual"},
            "monthly": {"$ref": "#/$defs/monthly"}
          }
        },
        "daily": {"$ref": "#/$defs/daily"},
        "hourly": {"$ref": "#/$defs/hourly"},
        "timeline": {
          "type": "object",
          "additionalProperties": false,
          "required": ["schema", "target_coordinate_candidate_id", "layer_order", "natal", "dayun", "xiaoyun", "annual", "monthly", "daily", "hourly", "classical_annotations", "semantic_scope"],
          "properties": {
            "schema": {"const": "BAZI-UNIFIED-TARGET-TIMELINE-R1"},
            "target_coordinate_candidate_id": {"$ref": "#/$defs/targetCandidateId"},
            "layer_order": {"const": ["NATAL", "DAYUN", "XIAOYUN", "ANNUAL", "MONTHLY", "DAILY", "HOURLY"]},
            "natal": {
              "type": "object", "additionalProperties": false,
              "required": ["source_application_candidate_ids", "natal_fact_hash"],
              "properties": {
                "source_application_candidate_ids": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/applicationCandidateId"}},
                "natal_fact_hash": {"$ref": "#/$defs/hash"}
              }
            },
            "dayun": {
              "type": "object", "additionalProperties": false,
              "required": ["kind", "frame"],
              "properties": {
                "kind": {"enum": ["PRE_DAYUN", "DAYUN"]},
                "frame": {"oneOf": [{"$ref": "#/$defs/activePreDayun"}, {"$ref": "#/$defs/activeDayun"}]}
              }
            },
            "xiaoyun": {
              "type": "object", "additionalProperties": false,
              "required": ["selection_status", "age_coordinate", "candidates"],
              "properties": {
                "selection_status": {"const": "UNRESOLVED_CLASSICAL_METHOD_ALTERNATIVES"},
                "age_coordinate": {
                  "type": "object", "additionalProperties": false,
                  "required": ["nominal_age", "profile_id", "source_class", "formula", "classical_age_boundary_status"],
                  "properties": {
                    "nominal_age": {"type": "integer", "minimum": 1},
                    "profile_id": {"const": "TARGET-CIVIL-YEAR-NOMINAL-AGE-R1"},
                    "source_class": {"const": "ENGINEERING_LINKAGE_COORDINATE"},
                    "formula": {"const": "target_local_civil_year-birth_local_civil_year+1"},
                    "classical_age_boundary_status": {"const": "NOT_ARBITRATED"}
                  }
                },
                "candidates": {
                  "type": "array", "minItems": 2,
                  "items": {
                    "type": "object", "additionalProperties": false,
                    "required": ["profile_id", "direction", "source_refs", "active_frame", "activation_status"],
                    "properties": {
                      "profile_id": {"type": "string"},
                      "direction": {"enum": ["FORWARD", "REVERSE"]},
                      "source_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
                      "active_frame": {
                        "type": ["object", "null"],
                        "properties": {"nominal_age": {"type": "integer"}, "ganzhi": {"type": "string"}},
                        "required": ["nominal_age", "ganzhi"]
                      },
                      "activation_status": {"enum": ["OPERATIONAL_CIVIL_NOMINAL_AGE_MATCH", "OUTSIDE_MATERIALIZED_XIAOYUN_RANGE"]}
                    }
                  }
                }
              }
            },
            "annual": {"$ref": "#/$defs/annual"},
            "monthly": {"$ref": "#/$defs/monthly"},
            "daily": {"$ref": "#/$defs/daily"},
            "hourly": {"$ref": "#/$defs/hourly"},
            "classical_annotations": {"$ref": "#/$defs/temporalAnnotationProjection"},
            "semantic_scope": {"const": "TEMPORAL_COORDINATES_ONLY_NO_INTERPRETATION"}
          }
        },
        "lineage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["natal_candidate_index", "source_temporal_candidate_indices", "source_application_candidate_ids", "source_flow_candidate_index", "source_target_coordinate_candidate_index"],
          "properties": {
            "natal_candidate_index": {"type": "integer", "minimum": 0},
            "source_temporal_candidate_indices": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 0}, "uniqueItems": true},
            "source_application_candidate_ids": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/applicationCandidateId"}},
            "source_flow_candidate_index": {"type": "integer", "minimum": 0},
            "source_target_coordinate_candidate_index": {"type": "integer", "minimum": 0}
          }
        },
        "integrity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["target_coordinate", "flow", "daily_hourly"],
          "properties": {
            "target_coordinate": {"const": "PASS"},
            "flow": {"const": "PASS"},
            "daily_hourly": {"const": "PASS"}
          }
        },
        "source_hashes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["natal_fact_hash", "temporal_fact_hash", "flow_fact_hash", "flow_computation_hash", "target_coordinate_fact_hash", "target_coordinate_computation_hash", "daily_hourly_fact_hash", "daily_hourly_computation_hash"],
          "properties": {
            "natal_fact_hash": {"$ref": "#/$defs/hash"},
            "temporal_fact_hash": {"$ref": "#/$defs/hash"},
            "flow_fact_hash": {"$ref": "#/$defs/hash"},
            "flow_computation_hash": {"$ref": "#/$defs/hash"},
            "target_coordinate_fact_hash": {"$ref": "#/$defs/hash"},
            "target_coordinate_computation_hash": {"$ref": "#/$defs/hash"},
            "daily_hourly_fact_hash": {"$ref": "#/$defs/hash"},
            "daily_hourly_computation_hash": {"$ref": "#/$defs/hash"}
          }
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_id", "natal_candidate_index", "source_temporal_candidate_indices", "source_application_candidate_ids", "source_flow_candidate_index", "source_target_coordinate_candidate_index", "target_coordinate_candidate_id", "natal_fact_hash", "temporal_fact_hash", "flow_fact_hash", "flow_computation_hash", "daily_hourly_fact_hash", "daily_hourly_computation_hash", "view_schema", "view", "view_hash"],
      "properties": {
        "candidate_id": {"type": "string", "pattern": "^BAZI-APPLICATION-FLOW-CANDIDATE:[0-9a-f]{64}$"},
        "natal_candidate_index": {"type": "integer", "minimum": 0},
        "source_temporal_candidate_indices": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 0}, "uniqueItems": true},
        "source_application_candidate_ids": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/applicationCandidateId"}},
        "source_flow_candidate_index": {"type": "integer", "minimum": 0},
        "source_target_coordinate_candidate_index": {"type": "integer", "minimum": 0},
        "target_coordinate_candidate_id": {"$ref": "#/$defs/targetCandidateId"},
        "natal_fact_hash": {"$ref": "#/$defs/hash"},
        "temporal_fact_hash": {"$ref": "#/$defs/hash"},
        "flow_fact_hash": {"$ref": "#/$defs/hash"},
        "flow_computation_hash": {"$ref": "#/$defs/hash"},
        "daily_hourly_fact_hash": {"$ref": "#/$defs/hash"},
        "daily_hourly_computation_hash": {"$ref": "#/$defs/hash"},
        "view_schema": {"const": "BAZI-APPLICATION-FLOW-VIEW-R1"},
        "view": {"$ref": "#/$defs/view"},
        "view_hash": {"$ref": "#/$defs/hash"}
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "diagnostics", "algorithm_id", "algorithm_version"],
      "properties": {
        "status": {"const": "PASS"},
        "diagnostics": {"type": "array", "maxItems": 0},
        "algorithm_id": {"const": "BAZI-APPLICATION-FLOW-INTEGRITY-R1"},
        "algorithm_version": {"const": "1.2.0"}
      }
    }
  }
}
