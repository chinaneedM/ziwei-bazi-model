{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/chinaneedM/ziwei-bazi-model/schemas/ziwei-named-structural-semantics-v2-r4.schema.json",
  "title": "Ziwei Structural Runtime V2-R4 Named Semantic State",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "upstream_r2_fact_hash",
    "upstream_r2_computation_hash",
    "profile",
    "opposition_axes",
    "trine_groups",
    "sanfang_sizheng_frames",
    "integrity",
    "hashes",
    "schema"
  ],
  "properties": {
    "upstream_r2_fact_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "upstream_r2_computation_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_id",
        "profile_version",
        "upstream_r2_profile_id",
        "upstream_r2_profile_version",
        "semantic_algorithm_id",
        "semantic_algorithm_version",
        "canonical_source_id",
        "canonical_source_sha256",
        "canonical_manifest_object_sha256",
        "semantic_rule_set_id",
        "semantic_rule_set_version"
      ],
      "properties": {
        "profile_id": {"const": "ZIWEI-STRUCTURAL-RUNTIME-V2-R4"},
        "profile_version": {"const": "1.0.0"},
        "upstream_r2_profile_id": {"const": "ZIWEI-STRUCTURAL-RUNTIME-V2-R2"},
        "upstream_r2_profile_version": {"const": "1.0.0"},
        "semantic_algorithm_id": {"const": "ZIWEI-NAMED-SANFANG-SIZHENG"},
        "semantic_algorithm_version": {"const": "1.0.0"},
        "canonical_source_id": {"const": "S04"},
        "canonical_source_sha256": {"const": "f7720ee4a11ce36155007cc3846620bcebdeaf5d98447c4abe427b37348e6c4f"},
        "canonical_manifest_object_sha256": {"const": "da7b511bb5734c09febccbe0ed54170490c27a6c0249df79e87c496f10d3e5e6"},
        "semantic_rule_set_id": {"const": "S04-SANFANG-SIZHENG-CORRECTION-R1"},
        "semantic_rule_set_version": {"const": "1.0.0"}
      }
    },
    "opposition_axes": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {"$ref": "#/$defs/oppositionAxis"}
    },
    "trine_groups": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {"$ref": "#/$defs/trineGroup"}
    },
    "sanfang_sizheng_frames": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": {"$ref": "#/$defs/sanfangSizhengFrame"}
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "diagnostics", "algorithm_id", "algorithm_version"],
      "properties": {
        "status": {"enum": ["PASS", "FAIL"]},
        "diagnostics": {"type": "array", "items": {"$ref": "#/$defs/integrityDiagnostic"}},
        "algorithm_id": {"const": "ZIWEI-NAMED-STRUCTURAL-SEMANTICS-INTEGRITY-HASH-V2-R4"},
        "algorithm_version": {"const": "1.0.0"}
      }
    },
    "hashes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fact_hash", "computation_hash", "algorithm_id", "algorithm_version"],
      "properties": {
        "fact_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "computation_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "algorithm_id": {"const": "ZIWEI-NAMED-STRUCTURAL-SEMANTICS-INTEGRITY-HASH-V2-R4"},
        "algorithm_version": {"const": "1.0.0"}
      }
    },
    "schema": {"const": "ZIWEI-NAMED-STRUCTURAL-SEMANTIC-STATE-V2-R4"}
  },
  "$defs": {
    "designationId": {
      "enum": [
        "LIFE", "SIBLINGS", "SPOUSE", "CHILDREN", "WEALTH", "HEALTH",
        "TRAVEL", "SERVANTS_FRIENDS", "CAREER", "PROPERTY", "FORTUNE", "PARENTS"
      ]
    },
    "address": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "branch"],
      "properties": {
        "index": {"type": "integer", "minimum": 0, "maximum": 11},
        "branch": {"enum": ["子", "丑", "寅", "卯", "辰", "巳", "午", "未", "申", "酉", "戌", "亥"]}
      }
    },
    "oppositionAxis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["axis_key", "member_designation_ids", "member_addresses"],
      "properties": {
        "axis_key": {"type": "string", "pattern": "^OPPOSITION_AXIS:"},
        "member_designation_ids": {
          "type": "array", "minItems": 2, "maxItems": 2,
          "items": {"$ref": "#/$defs/designationId"}
        },
        "member_addresses": {
          "type": "array", "minItems": 2, "maxItems": 2,
          "items": {"$ref": "#/$defs/address"}
        }
      }
    },
    "trineGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["group_key", "member_designation_ids", "member_addresses"],
      "properties": {
        "group_key": {"type": "string", "pattern": "^TRINE_GROUP:"},
        "member_designation_ids": {
          "type": "array", "minItems": 3, "maxItems": 3,
          "items": {"$ref": "#/$defs/designationId"}
        },
        "member_addresses": {
          "type": "array", "minItems": 3, "maxItems": 3,
          "items": {"$ref": "#/$defs/address"}
        }
      }
    },
    "sanfangSizhengFrame": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "origin_designation_id", "origin_address", "trine_group_key",
        "trine_partner_designation_ids", "trine_partner_addresses", "trine_offsets",
        "opposition_axis_key", "opposition_designation_id", "opposition_address",
        "opposition_offset"
      ],
      "properties": {
        "origin_designation_id": {"$ref": "#/$defs/designationId"},
        "origin_address": {"$ref": "#/$defs/address"},
        "trine_group_key": {"type": "string", "pattern": "^TRINE_GROUP:"},
        "trine_partner_designation_ids": {
          "type": "array", "minItems": 2, "maxItems": 2,
          "items": {"$ref": "#/$defs/designationId"}
        },
        "trine_partner_addresses": {
          "type": "array", "minItems": 2, "maxItems": 2,
          "items": {"$ref": "#/$defs/address"}
        },
        "trine_offsets": {
          "type": "array", "prefixItems": [{"const": 4}, {"const": 8}],
          "items": false, "minItems": 2, "maxItems": 2
        },
        "opposition_axis_key": {"type": "string", "pattern": "^OPPOSITION_AXIS:"},
        "opposition_designation_id": {"$ref": "#/$defs/designationId"},
        "opposition_address": {"$ref": "#/$defs/address"},
        "opposition_offset": {"const": 6}
      }
    },
    "integrityDiagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "path", "detail"],
      "properties": {
        "code": {"type": "string"},
        "path": {"type": "string"},
        "detail": {"type": "string"}
      }
    }
  }
}
