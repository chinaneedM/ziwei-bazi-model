{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/chinaneedM/ziwei-bazi-model/schemas/bazi-stem-five-combination-eligibility-evidence-binding-r1.schema.json",
  "title": "Bazi Stem Five-Combination Eligibility Evidence Binding R1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "audit_id",
    "authority",
    "scope",
    "method",
    "closed_vocabularies",
    "runtime_predicate_registry",
    "records",
    "summary",
    "determinism"
  ],
  "properties": {
    "schema": {"const": "BAZI-STEM-FIVE-COMBINATION-ELIGIBILITY-EVIDENCE-BINDING-R1"},
    "audit_id": {"const": "BAZI-STEM-FIVE-COMBINATION-ELIGIBILITY-EVIDENCE-BINDING-R1"},
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "canonical_source_sha256",
        "source_access_index_path",
        "source_access_index_sha256",
        "source_matrix_path",
        "source_matrix_sha256",
        "source_matrix_audit_id",
        "runtime_contract_file_sha256",
        "runtime_contract_manifest_sha256"
      ],
      "properties": {
        "source_id": {"const": "S14"},
        "canonical_source_sha256": {"const": "b225e64fcf7238b27a634e653a6904403d518335aeca59372b32e02f4a560407"},
        "source_access_index_path": {"const": "sources/derived-access/S14/index.json"},
        "source_access_index_sha256": {"$ref": "#/$defs/sha256"},
        "source_matrix_path": {"const": "audits/bazi-classical-relation-lifecycle-evidence-r1/matrix.json"},
        "source_matrix_sha256": {"$ref": "#/$defs/sha256"},
        "source_matrix_audit_id": {"const": "BAZI-CLASSICAL-RELATION-LIFECYCLE-EVIDENCE-MATRIX-R1"},
        "runtime_contract_file_sha256": {
          "type": "object",
          "minProperties": 10,
          "additionalProperties": {"$ref": "#/$defs/sha256"},
          "propertyNames": {"type": "string", "minLength": 1}
        },
        "runtime_contract_manifest_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_role",
        "source_relation_family",
        "per_chart_runtime_evaluator_released",
        "classical_outcome_semantics_released",
        "free_text_semantic_compiler_used",
        "profile_default_selected"
      ],
      "properties": {
        "artifact_role": {"const": "STATIC_SOURCE_TO_RELEASED_NEUTRAL_RUNTIME_BINDING_ONLY"},
        "source_relation_family": {"const": "STEM_FIVE_COMBINATION"},
        "per_chart_runtime_evaluator_released": {"const": false},
        "classical_outcome_semantics_released": {"const": false},
        "free_text_semantic_compiler_used": {"const": false},
        "profile_default_selected": {"const": false}
      }
    },
    "method": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm_id",
        "algorithm_version",
        "source_selection",
        "binding_input",
        "ordering",
        "expected_regression_count"
      ],
      "properties": {
        "algorithm_id": {"const": "S14_FIVE_COMBINATION_MATRIX_METADATA_BINDING_R1"},
        "algorithm_version": {"const": "1.0.0"},
        "source_selection": {"const": "MATRIX_RELATION_FAMILY_EXACT_MEMBERSHIP"},
        "binding_input": {"const": "REVIEWED_MATRIX_METADATA_NOT_SOURCE_FREE_TEXT"},
        "ordering": {"const": "SOURCE_EVIDENCE_ID_ASCENDING"},
        "expected_regression_count": {"const": 215}
      }
    },
    "closed_vocabularies": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "binding_dispositions",
        "binding_assertion_strengths",
        "neutral_predicate_kinds",
        "required_unresolved_primitives"
      ],
      "properties": {
        "binding_dispositions": {
          "const": [
            "EXACT_NEUTRAL_BINDING",
            "RELATED_NEUTRAL_EVIDENCE_ONLY",
            "PARTIAL_BINDING",
            "NO_BINDING_MISSING_PRIMITIVE",
            "NO_BINDING_SOURCE_SEMANTICS_AMBIGUOUS",
            "PROFILE_ALTERNATIVE_UNRESOLVED",
            "NON_CONDITION_RECORD"
          ]
        },
        "binding_assertion_strengths": {
          "const": ["EXACT_IDENTITY_BINDING", "RELATED_NEUTRAL_EVIDENCE"]
        },
        "neutral_predicate_kinds": {
          "type": "array",
          "minItems": 22,
          "maxItems": 22,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/predicateKind"}
        },
        "required_unresolved_primitives": {
          "type": "array",
          "minItems": 9,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "runtime_predicate_registry": {
      "type": "object",
      "minProperties": 22,
      "maxProperties": 22,
      "additionalProperties": {"$ref": "#/$defs/runtimePredicateSpec"},
      "propertyNames": {"$ref": "#/$defs/predicateKind"}
    },
    "records": {
      "type": "array",
      "minItems": 215,
      "maxItems": 215,
      "items": {"$ref": "#/$defs/bindingRecord"}
    },
    "summary": {"$ref": "#/$defs/summary"},
    "determinism": {
      "type": "object",
      "additionalProperties": false,
      "required": ["records_semantics_sha256", "closed_registry_sha256", "catalog_semantics_sha256"],
      "properties": {
        "records_semantics_sha256": {"$ref": "#/$defs/sha256"},
        "closed_registry_sha256": {"$ref": "#/$defs/sha256"},
        "catalog_semantics_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "stringArray": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "predicateKind": {
      "enum": [
        "RELATION_OCCURRENCE_IDENTITY",
        "NOMINAL_TRANSFORMATION_ELEMENT_IDENTITY",
        "PARTICIPANT_STEM_IDENTITY",
        "PARTICIPANT_ELEMENT_IDENTITY",
        "PARTICIPANT_POLARITY_IDENTITY",
        "PARTICIPANT_LAYER_IDENTITY",
        "TEMPORAL_FRAME_IDENTITY",
        "NATAL_POSITION_DOMAIN",
        "NATAL_PILLAR_ORDINALS",
        "NATAL_ORDINAL_DISTANCE",
        "NATAL_INTERVENING_VISIBLE_STEM_IDS",
        "INTERVENER_STEM_IDENTITY",
        "NATAL_DAY_MASTER_PARTICIPATION",
        "PARTICIPANT_RELATION_DEGREE",
        "RELATION_PAIR_SHARED_PARTICIPANT_TOPOLOGY",
        "NATAL_MONTH_COMMAND_REFERENCE",
        "ACTIVE_FLOW_SOLAR_MONTH_REFERENCE",
        "EXACT_HIDDEN_STEM_MATCH_REFERENCE",
        "SAME_ELEMENT_HIDDEN_SUPPORT_REFERENCE",
        "SUPPORT_TOUCH_REFERENCE",
        "EXPOSURE_LINK_REFERENCE",
        "RELATION_TRANSITION_SET_MEMBERSHIP"
      ]
    },
    "runtimePredicateSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime_contract", "runtime_fact_or_field_paths"],
      "properties": {
        "runtime_contract": {"type": "string", "minLength": 1},
        "runtime_fact_or_field_paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^fortune_training\\.[a-z0-9_.]+:[A-Za-z][A-Za-z0-9_]*\\.[a-z][a-z0-9_]*$"}
        }
      }
    },
    "runtimeDependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primitive", "status", "rationale"],
      "properties": {
        "primitive": {"type": "string", "minLength": 1},
        "status": {
          "enum": [
            "AVAILABLE_EXACTLY",
            "AVAILABLE_AS_NEUTRAL_EVIDENCE_ONLY",
            "PARTIALLY_AVAILABLE",
            "MISSING_PRIMITIVE",
            "OUTSIDE_CURRENT_RELATION_REGISTRY",
            "SOURCE_SEMANTICS_AMBIGUOUS"
          ]
        },
        "rationale": {"type": "string", "minLength": 1}
      }
    },
    "predicateBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "predicate_kind",
        "binding_assertion_strength",
        "runtime_contract",
        "runtime_fact_or_field_paths",
        "source_applicability_scope",
        "rationale"
      ],
      "properties": {
        "predicate_kind": {"$ref": "#/$defs/predicateKind"},
        "binding_assertion_strength": {"enum": ["EXACT_IDENTITY_BINDING", "RELATED_NEUTRAL_EVIDENCE"]},
        "runtime_contract": {"type": "string", "minLength": 1},
        "runtime_fact_or_field_paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "source_applicability_scope": {"const": "EXACT_EVIDENCE_RECORD_DEPENDENCY"},
        "rationale": {"type": "string", "minLength": 1}
      }
    },
    "bindingRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "binding_id",
        "source_evidence_id",
        "source_id",
        "canonical_source_path",
        "canonical_source_sha256",
        "access_segment_id",
        "access_segment_path",
        "access_segment_sha256",
        "canonical_line_start",
        "canonical_line_end",
        "segment_local_line_start",
        "segment_local_line_end",
        "canonical_byte_start",
        "canonical_byte_end_exclusive",
        "passage_sha256",
        "source_statement_class",
        "source_secondary_statement_classes",
        "source_condition_dependency_tags",
        "source_review_status",
        "source_conflict_group_ids",
        "source_alternative_profile_labels",
        "source_runtime_dependency_map",
        "binding_disposition",
        "neutral_predicate_bindings",
        "unresolved_runtime_primitives",
        "source_semantics_ambiguous",
        "profile_selection_required",
        "binding_notes"
      ],
      "properties": {
        "binding_id": {"type": "string", "pattern": "^S14-FIVE-COMBINATION-BINDING:[0-9a-f]{64}$"},
        "source_evidence_id": {"type": "string", "pattern": "^S14-EV-L[0-9]{5}-[0-9a-f]{12}$"},
        "source_id": {"const": "S14"},
        "canonical_source_path": {"const": "sources/canonical/S14_八字合冲刑害墓库与结构变化库.txt"},
        "canonical_source_sha256": {"const": "b225e64fcf7238b27a634e653a6904403d518335aeca59372b32e02f4a560407"},
        "access_segment_id": {"type": "string", "pattern": "^S14-[0-9]{4}$"},
        "access_segment_path": {"type": "string", "pattern": "^sources/derived-access/S14/segment-[0-9]{4}\\.txt$"},
        "access_segment_sha256": {"$ref": "#/$defs/sha256"},
        "canonical_line_start": {"type": "integer", "minimum": 1},
        "canonical_line_end": {"type": "integer", "minimum": 1},
        "segment_local_line_start": {"type": "integer", "minimum": 1},
        "segment_local_line_end": {"type": "integer", "minimum": 1},
        "canonical_byte_start": {"type": "integer", "minimum": 0},
        "canonical_byte_end_exclusive": {"type": "integer", "minimum": 1},
        "passage_sha256": {"$ref": "#/$defs/sha256"},
        "source_statement_class": {"type": "string", "minLength": 1},
        "source_secondary_statement_classes": {"$ref": "#/$defs/stringArray"},
        "source_condition_dependency_tags": {"$ref": "#/$defs/stringArray"},
        "source_review_status": {"type": "string", "minLength": 1},
        "source_conflict_group_ids": {"$ref": "#/$defs/stringArray"},
        "source_alternative_profile_labels": {"$ref": "#/$defs/stringArray"},
        "source_runtime_dependency_map": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/runtimeDependency"}
        },
        "binding_disposition": {
          "enum": [
            "EXACT_NEUTRAL_BINDING",
            "RELATED_NEUTRAL_EVIDENCE_ONLY",
            "PARTIAL_BINDING",
            "NO_BINDING_MISSING_PRIMITIVE",
            "NO_BINDING_SOURCE_SEMANTICS_AMBIGUOUS",
            "PROFILE_ALTERNATIVE_UNRESOLVED",
            "NON_CONDITION_RECORD"
          ]
        },
        "neutral_predicate_bindings": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/predicateBinding"}
        },
        "unresolved_runtime_primitives": {"$ref": "#/$defs/stringArray"},
        "source_semantics_ambiguous": {"type": "boolean"},
        "profile_selection_required": {"type": "boolean"},
        "binding_notes": {"type": "string", "minLength": 1}
      }
    },
    "countMap": {
      "type": "object",
      "additionalProperties": {"type": "integer", "minimum": 1},
      "propertyNames": {"type": "string", "minLength": 1}
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "five_combination_evidence_count",
        "statement_class_counts",
        "binding_disposition_counts",
        "neutral_predicate_counts",
        "missing_primitive_counts",
        "relevant_conflict_group_count",
        "relevant_conflict_group_ids",
        "relevant_profile_label_count",
        "relevant_profile_labels",
        "source_semantics_ambiguous_count",
        "source_semantics_ambiguous_evidence_ids",
        "unbound_record_count",
        "unbound_evidence_ids"
      ],
      "properties": {
        "five_combination_evidence_count": {"const": 215},
        "statement_class_counts": {"$ref": "#/$defs/countMap"},
        "binding_disposition_counts": {"$ref": "#/$defs/countMap"},
        "neutral_predicate_counts": {"$ref": "#/$defs/countMap"},
        "missing_primitive_counts": {"$ref": "#/$defs/countMap"},
        "relevant_conflict_group_count": {"type": "integer", "minimum": 0},
        "relevant_conflict_group_ids": {"$ref": "#/$defs/stringArray"},
        "relevant_profile_label_count": {"type": "integer", "minimum": 0},
        "relevant_profile_labels": {"$ref": "#/$defs/stringArray"},
        "source_semantics_ambiguous_count": {"type": "integer", "minimum": 0},
        "source_semantics_ambiguous_evidence_ids": {"$ref": "#/$defs/stringArray"},
        "unbound_record_count": {"type": "integer", "minimum": 0},
        "unbound_evidence_ids": {"$ref": "#/$defs/stringArray"}
      }
    }
  }
}
