{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/chinaneedM/ziwei-bazi-model/schemas/ziwei-chart-view-v1.schema.json",
  "title": "Ziwei Chart View Model V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "presentation_profile_id",
    "presentation_profile_version",
    "source_fact_hash",
    "source_computation_hash",
    "selected_temporal_frame_ids",
    "selected_temporal_frame_summary",
    "daxian_sequence_metadata",
    "roles",
    "cells",
    "view_hash"
  ],
  "properties": {
    "schema": {
      "const": "ZIWEI-CHART-VIEW-MODEL-V1"
    },
    "presentation_profile_id": {
      "type": "string",
      "minLength": 1
    },
    "presentation_profile_version": {
      "type": "string",
      "minLength": 1
    },
    "source_fact_hash": {
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_computation_hash": {
      "pattern": "^[0-9a-f]{64}$"
    },
    "selected_temporal_frame_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "selected_temporal_frame_summary": {
      "$ref": "#/$defs/selectedTemporalFrameSummary"
    },
    "daxian_sequence_metadata": {
      "anyOf": [
        {
          "$ref": "#/$defs/daxianSequenceMetadata"
        },
        {
          "type": "null"
        }
      ]
    },
    "roles": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/role"
      }
    },
    "cells": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": {
        "$ref": "#/$defs/cell"
      }
    },
    "view_hash": {
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "$defs": {
    "placement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entity_id",
        "label",
        "dignity_grade",
        "dignity_status",
        "transformation_badges"
      ],
      "properties": {
        "entity_id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "dignity_grade": {
          "enum": [
            "庙",
            "旺",
            "得",
            "利",
            "平",
            "不",
            "陷",
            null
          ]
        },
        "dignity_status": {
          "enum": [
            "GRADED",
            "UNRATED",
            null
          ]
        },
        "transformation_badges": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "ringMember": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ring_id",
        "member_id",
        "label"
      ],
      "properties": {
        "ring_id": {
          "type": "string",
          "minLength": 1
        },
        "member_id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "temporalDesignation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frame_type",
        "frame_id",
        "designation_id",
        "label"
      ],
      "properties": {
        "frame_type": {
          "enum": [
            "DAXIAN",
            "ANNUAL",
            "MONTH"
          ]
        },
        "frame_id": {
          "type": "string",
          "minLength": 1
        },
        "designation_id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "temporalAuxiliary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frame_type",
        "frame_id",
        "entity_id",
        "label"
      ],
      "properties": {
        "frame_type": {
          "enum": [
            "DAXIAN",
            "ANNUAL",
            "MONTH"
          ]
        },
        "frame_id": {
          "type": "string",
          "minLength": 1
        },
        "entity_id": {
          "enum": [
            "STAR.LUCUN",
            "STAR.QINGYANG",
            "STAR.TUOLUO",
            "STAR.WENCHANG",
            "STAR.WENQU"
          ]
        },
        "label": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "temporalAuxiliaryCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frame_type",
        "frame_id",
        "candidate_set_id",
        "candidate_id",
        "method_id",
        "authority_status",
        "entity_id",
        "label",
        "candidate_fact_hash"
      ],
      "properties": {
        "frame_type": {
          "enum": [
            "DAXIAN",
            "ANNUAL",
            "MONTH"
          ]
        },
        "frame_id": {
          "type": "string",
          "minLength": 1
        },
        "candidate_set_id": {
          "type": "string",
          "minLength": 1
        },
        "candidate_id": {
          "type": "string",
          "minLength": 1
        },
        "method_id": {
          "enum": [
            "S01-QS-STRICT-KUI-YUE-R1",
            "COMPAT-WENMO-KUI-YUE-R1",
            "S10-LIMIT-PALACE-BRANCH-TIANMA-CASE-R1",
            "S10-ANNUAL-BRANCH-TIANMA-CASE-R1"
          ]
        },
        "authority_status": {
          "enum": [
            "CANONICAL_SOURCE_TABLE",
            "EXTERNAL_CASE_COMPATIBILITY",
            "CASE_METHOD_ONLY",
            "S01_STRICT_PROJECT_CORPUS_METHOD"
          ]
        },
        "entity_id": {
          "enum": [
            "STAR.TIANKUI",
            "STAR.TIANYUE",
            "STAR.TIANMA"
          ]
        },
        "label": {
          "enum": [
            "天魁",
            "天钺",
            "天马"
          ]
        },
        "candidate_fact_hash": {
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "daxianFrameSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frame_id",
        "index",
        "nominal_age_start",
        "nominal_age_end",
        "absolute_year_start",
        "absolute_year_end",
        "active_address_index",
        "active_branch",
        "active_palace_ganzhi"
      ],
      "properties": {
        "frame_id": {
          "type": "string",
          "minLength": 1
        },
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "nominal_age_start": {
          "type": "integer",
          "minimum": 1
        },
        "nominal_age_end": {
          "type": "integer",
          "minimum": 1
        },
        "absolute_year_start": {
          "type": "integer"
        },
        "absolute_year_end": {
          "type": "integer"
        },
        "active_address_index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 11
        },
        "active_branch": {
          "enum": [
            "子",
            "丑",
            "寅",
            "卯",
            "辰",
            "巳",
            "午",
            "未",
            "申",
            "酉",
            "戌",
            "亥"
          ]
        },
        "active_palace_ganzhi": {
          "type": "string",
          "minLength": 2
        }
      }
    },
    "annualFrameSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frame_id",
        "absolute_year",
        "nominal_age",
        "year_stem",
        "year_branch",
        "active_address_index",
        "active_branch",
        "active_palace_ganzhi"
      ],
      "properties": {
        "frame_id": {
          "type": "string",
          "minLength": 1
        },
        "absolute_year": {
          "type": "integer"
        },
        "nominal_age": {
          "type": "integer",
          "minimum": 1
        },
        "year_stem": {
          "enum": [
            "甲",
            "乙",
            "丙",
            "丁",
            "戊",
            "己",
            "庚",
            "辛",
            "壬",
            "癸"
          ]
        },
        "year_branch": {
          "enum": [
            "子",
            "丑",
            "寅",
            "卯",
            "辰",
            "巳",
            "午",
            "未",
            "申",
            "酉",
            "戌",
            "亥"
          ]
        },
        "active_address_index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 11
        },
        "active_branch": {
          "enum": [
            "子",
            "丑",
            "寅",
            "卯",
            "辰",
            "巳",
            "午",
            "未",
            "申",
            "酉",
            "戌",
            "亥"
          ]
        },
        "active_palace_ganzhi": {
          "type": "string",
          "minLength": 2
        }
      }
    },
    "monthlyFrameSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frame_id",
        "absolute_year",
        "lunar_month",
        "month_stem",
        "month_branch",
        "month_ganzhi",
        "active_address_index",
        "active_branch",
        "calendar_scope",
        "leap_month_policy_status"
      ],
      "properties": {
        "frame_id": {
          "type": "string",
          "minLength": 1
        },
        "absolute_year": {
          "type": "integer"
        },
        "lunar_month": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        },
        "month_stem": {
          "enum": [
            "甲",
            "乙",
            "丙",
            "丁",
            "戊",
            "己",
            "庚",
            "辛",
            "壬",
            "癸"
          ]
        },
        "month_branch": {
          "enum": [
            "子",
            "丑",
            "寅",
            "卯",
            "辰",
            "巳",
            "午",
            "未",
            "申",
            "酉",
            "戌",
            "亥"
          ]
        },
        "month_ganzhi": {
          "type": "string",
          "minLength": 2
        },
        "active_address_index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 11
        },
        "active_branch": {
          "enum": [
            "子",
            "丑",
            "寅",
            "卯",
            "辰",
            "巳",
            "午",
            "未",
            "申",
            "酉",
            "戌",
            "亥"
          ]
        },
        "calendar_scope": {
          "type": "string",
          "minLength": 1
        },
        "leap_month_policy_status": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "minorLimitFrameSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frame_id",
        "nominal_age",
        "active_address_index",
        "active_branch"
      ],
      "properties": {
        "frame_id": {
          "type": "string",
          "minLength": 1
        },
        "nominal_age": {
          "type": "integer",
          "minimum": 1
        },
        "active_address_index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 11
        },
        "active_branch": {
          "enum": [
            "子",
            "丑",
            "寅",
            "卯",
            "辰",
            "巳",
            "午",
            "未",
            "申",
            "酉",
            "戌",
            "亥"
          ]
        }
      }
    },
    "selectedTemporalFrameSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "daxian",
        "annual",
        "monthly",
        "minor_limit"
      ],
      "properties": {
        "daxian": {
          "anyOf": [
            {
              "$ref": "#/$defs/daxianFrameSummary"
            },
            {
              "type": "null"
            }
          ]
        },
        "annual": {
          "anyOf": [
            {
              "$ref": "#/$defs/annualFrameSummary"
            },
            {
              "type": "null"
            }
          ]
        },
        "monthly": {
          "anyOf": [
            {
              "$ref": "#/$defs/monthlyFrameSummary"
            },
            {
              "type": "null"
            }
          ]
        },
        "minor_limit": {
          "anyOf": [
            {
              "$ref": "#/$defs/minorLimitFrameSummary"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "daxianSequenceMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "daxian_direction",
        "first_daxian_nominal_age"
      ],
      "properties": {
        "daxian_direction": {
          "enum": [
            "FORWARD",
            "REVERSE"
          ]
        },
        "first_daxian_nominal_age": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "role": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role_id",
        "label",
        "entity_id",
        "entity_label"
      ],
      "properties": {
        "role_id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "entity_id": {
          "type": "string",
          "minLength": 1
        },
        "entity_label": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "cell": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "address_index",
        "branch",
        "stem",
        "natal_designation_id",
        "natal_designation_label",
        "placements",
        "ring_members",
        "temporal_designations",
        "temporal_auxiliaries",
        "temporal_auxiliary_candidates",
        "minor_limit_frame_ids",
        "doujun_frame_ids"
      ],
      "properties": {
        "address_index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 11
        },
        "branch": {
          "enum": [
            "子",
            "丑",
            "寅",
            "卯",
            "辰",
            "巳",
            "午",
            "未",
            "申",
            "酉",
            "戌",
            "亥"
          ]
        },
        "stem": {
          "enum": [
            "甲",
            "乙",
            "丙",
            "丁",
            "戊",
            "己",
            "庚",
            "辛",
            "壬",
            "癸"
          ]
        },
        "natal_designation_id": {
          "type": "string",
          "minLength": 1
        },
        "natal_designation_label": {
          "type": "string",
          "minLength": 1
        },
        "placements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/placement"
          }
        },
        "ring_members": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ringMember"
          }
        },
        "temporal_designations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/temporalDesignation"
          }
        },
        "temporal_auxiliaries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/temporalAuxiliary"
          }
        },
        "temporal_auxiliary_candidates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/temporalAuxiliaryCandidate"
          }
        },
        "minor_limit_frame_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "doujun_frame_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
