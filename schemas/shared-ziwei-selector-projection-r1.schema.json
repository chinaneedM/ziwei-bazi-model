{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/chinaneedM/ziwei-bazi-model/schemas/shared-ziwei-selector-projection-r1.schema.json",
  "title": "Shared Target to Ziwei Selector Projection R1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "status", "source_ziwei_application_bundle_hash",
    "source_ziwei_temporal_fact_hash", "source_ziwei_temporal_computation_hash",
    "source_target_coordinate_fact_hash", "source_target_coordinate_computation_hash",
    "source_target_coordinate_profile_id", "source_target_coordinate_profile_version",
    "candidates", "hashes", "integrity"
  ],
  "properties": {
    "schema": {"const": "SHARED-ZIWEI-SELECTOR-PROJECTION-RESOLUTION-R1"},
    "status": {"const": "RESOLVED"},
    "source_ziwei_application_bundle_hash": {"$ref": "#/$defs/hash"},
    "source_ziwei_temporal_fact_hash": {"$ref": "#/$defs/hash"},
    "source_ziwei_temporal_computation_hash": {"$ref": "#/$defs/hash"},
    "source_target_coordinate_fact_hash": {"$ref": "#/$defs/hash"},
    "source_target_coordinate_computation_hash": {"$ref": "#/$defs/hash"},
    "source_target_coordinate_profile_id": {"type": "string", "minLength": 1},
    "source_target_coordinate_profile_version": {"type": "string", "minLength": 1},
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/candidate"}
    },
    "hashes": {"$ref": "#/$defs/hashes"},
    "integrity": {"$ref": "#/$defs/integrity"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "dateTime": {"type": "string", "minLength": 19},
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_target_candidate_index", "source_target_candidate_id", "source_sample_index",
        "sample_reported_local_datetime", "target_utc", "fold", "civil_year",
        "source_annual_frame_id", "annual_year", "minor_limit_age", "daxian_frame_id",
        "ziwei_calendar_date_policy", "ziwei_day_boundary_policy",
        "effective_lunar_year", "effective_lunar_month", "effective_lunar_day",
        "effective_lunar_is_leap_month", "monthly_projection_status",
        "monthly_frame_id", "monthly_ganzhi", "monthly_active_address_branch",
        "daily_projection_status", "daily_frame_id", "daily_effective_gregorian_date",
        "daily_ganzhi", "daily_active_address_branch", "daily_rule_id",
        "daily_source_refs", "daily_transformation_status",
        "daily_transformation_rule_set_id", "daily_transformation_rule_set_version",
        "daily_transformations", "daily_transformation_source_refs",
        "hourly_projection_status", "hourly_method_candidates",
        "candidate_hash"
      ],
      "properties": {
        "source_target_candidate_index": {"type": "integer", "minimum": 0},
        "source_target_candidate_id": {"type": "string", "minLength": 1},
        "source_sample_index": {"type": "integer", "minimum": 0},
        "sample_reported_local_datetime": {"$ref": "#/$defs/dateTime"},
        "target_utc": {"$ref": "#/$defs/dateTime"},
        "fold": {"enum": [0, 1]},
        "civil_year": {"type": "integer", "minimum": 1},
        "source_annual_frame_id": {"type": "string", "pattern": "^ANNUAL:[0-9]+$"},
        "annual_year": {"type": "integer", "minimum": 1},
        "minor_limit_age": {"type": "integer", "minimum": 1},
        "daxian_frame_id": {
          "anyOf": [
            {"type": "string", "pattern": "^DAXIAN:index=[1-9][0-9]*$"},
            {"type": "null"}
          ]
        },
        "ziwei_calendar_date_policy": {"enum": ["LOCAL_SOLAR_DATE_INDEXED", "ABSOLUTE_CALENDAR"]},
        "ziwei_day_boundary_policy": {"enum": ["MIDNIGHT", "ZI_START_23"]},
        "effective_lunar_year": {"type": "integer", "minimum": 1},
        "effective_lunar_month": {"type": "integer", "minimum": 1, "maximum": 12},
        "effective_lunar_day": {"type": "integer", "minimum": 1, "maximum": 30},
        "effective_lunar_is_leap_month": {"type": "boolean"},
        "monthly_projection_status": {"enum": ["REGULAR_LUNAR_MONTH_RESOLVED", "LEAP_MONTH_UNRESOLVED_NO_FRAME"]},
        "monthly_frame_id": {"type": ["string", "null"], "pattern": "^MONTH:[0-9]+:(?:[1-9]|1[0-2])$"},
        "monthly_ganzhi": {"type": ["string", "null"], "minLength": 2, "maxLength": 2},
        "monthly_active_address_branch": {"type": ["string", "null"], "minLength": 1, "maxLength": 1},
        "daily_projection_status": {"enum": ["REGULAR_LUNAR_DAY_RESOLVED", "PARENT_LEAP_MONTH_UNRESOLVED_NO_FRAME"]},
        "daily_frame_id": {"type": ["string", "null"], "pattern": "^DAY:[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
        "daily_effective_gregorian_date": {"type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
        "daily_ganzhi": {"type": ["string", "null"], "minLength": 2, "maxLength": 2},
        "daily_active_address_branch": {"type": ["string", "null"], "minLength": 1, "maxLength": 1},
        "daily_rule_id": {"type": ["string", "null"]},
        "daily_source_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "daily_transformation_status": {"enum": ["PROFILE_RULE_SET_RESOLVED", "PROFILE_TRANSFORMATIONS_DISABLED", "PARENT_DAILY_FRAME_UNRESOLVED"]},
        "daily_transformation_rule_set_id": {"type": ["string", "null"]},
        "daily_transformation_rule_set_version": {"type": ["string", "null"]},
        "daily_transformations": {"type": "array", "maxItems": 4, "items": {"$ref": "#/$defs/transformation"}},
        "daily_transformation_source_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "hourly_projection_status": {"const": "CANDIDATES_PRESERVED_NO_SELECTED_FRAME"},
        "hourly_method_candidates": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {"$ref": "#/$defs/hourlyCandidate"}
        },
        "candidate_hash": {"$ref": "#/$defs/hash"}
      }
    },
    "hourlyCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id", "time_standard", "source_local_datetime",
        "ziwei_day_boundary_policy", "effective_gregorian_date", "day_ganzhi",
        "hour_branch", "hour_ganzhi", "frame_status", "active_address_branch",
        "transformation_status", "transformation_rule_set_id",
        "transformation_rule_set_version", "transformations", "transformation_source_refs",
        "rule_id", "authority_status", "source_refs"
      ],
      "properties": {
        "candidate_id": {"type": "string", "minLength": 1},
        "time_standard": {"enum": ["ZHONGZHOU_LUOYANG_MEAN_SOLAR_TIME", "LOCAL_APPARENT_SOLAR_TIME"]},
        "source_local_datetime": {"$ref": "#/$defs/dateTime"},
        "ziwei_day_boundary_policy": {"enum": ["MIDNIGHT", "ZI_START_23"]},
        "effective_gregorian_date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
        "day_ganzhi": {"type": "string", "minLength": 2, "maxLength": 2},
        "hour_branch": {"type": "string", "minLength": 1, "maxLength": 1},
        "hour_ganzhi": {"type": "string", "minLength": 2, "maxLength": 2},
        "frame_status": {"const": "ACTIVE_ADDRESS_NOT_GENERATED_CASE_METHOD_ONLY"},
        "active_address_branch": {"type": "null"},
        "transformation_status": {"enum": ["CASE_METHOD_PROFILE_RULE_SET_RESOLVED", "CASE_METHOD_PROFILE_TRANSFORMATIONS_DISABLED"]},
        "transformation_rule_set_id": {"type": ["string", "null"]},
        "transformation_rule_set_version": {"type": ["string", "null"]},
        "transformations": {"type": "array", "maxItems": 4, "items": {"$ref": "#/$defs/transformation"}},
        "transformation_source_refs": {
          "type": "array",
          "minItems": 2,
          "items": {"type": "string", "minLength": 1}
        },
        "rule_id": {"const": "S10-CASE-FIVE-RATS-HOUR-CANDIDATE-R1"},
        "authority_status": {"const": "CASE_METHOD_ONLY_NOT_GLOBAL_RULE"},
        "source_refs": {
          "type": "array",
          "minItems": 6,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "address": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "branch"],
      "properties": {
        "index": {"type": "integer", "minimum": 0, "maximum": 11},
        "branch": {"enum": ["子","丑","寅","卯","辰","巳","午","未","申","酉","戌","亥"]}
      }
    },
    "transformation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "activation_id", "transformation_type", "target_entity_id", "target_display_name",
        "target_address", "source_layer", "source_stem", "context_id", "assignment_id",
        "mechanism_id", "generator_id", "algorithm_version", "source_refs"
      ],
      "properties": {
        "activation_id": {"type": "string", "minLength": 1},
        "transformation_type": {"enum": ["化禄","化权","化科","化忌"]},
        "target_entity_id": {"type": "string", "minLength": 1},
        "target_display_name": {"type": "string", "minLength": 1},
        "target_address": {"$ref": "#/$defs/address"},
        "source_layer": {"enum": ["DAY", "HOUR_CANDIDATE"]},
        "source_stem": {"enum": ["甲","乙","丙","丁","戊","己","庚","辛","壬","癸"]},
        "context_id": {"type": "string", "minLength": 1},
        "assignment_id": {"type": "string", "minLength": 1},
        "mechanism_id": {"type": "string", "minLength": 1},
        "generator_id": {"const": "ZIWEI-TRANSFORMATION-ACTIVATION-V1"},
        "algorithm_version": {"const": "1.0.0"},
        "source_refs": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 1}}
      }
    },
    "hashes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fact_hash", "computation_hash", "algorithm_id", "algorithm_version"],
      "properties": {
        "fact_hash": {"$ref": "#/$defs/hash"},
        "computation_hash": {"$ref": "#/$defs/hash"},
        "algorithm_id": {"const": "SHARED-TARGET-ZIWEI-SELECTOR-PROJECTION-HASH-R1"},
        "algorithm_version": {"const": "1.3.0"}
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "diagnostics", "algorithm_id", "algorithm_version"],
      "properties": {
        "status": {"const": "PASS"},
        "diagnostics": {"type": "array", "maxItems": 0},
        "algorithm_id": {"const": "SHARED-TARGET-ZIWEI-SELECTOR-PROJECTION-INTEGRITY-R1"},
        "algorithm_version": {"const": "1.3.0"}
      }
    }
  }
}
