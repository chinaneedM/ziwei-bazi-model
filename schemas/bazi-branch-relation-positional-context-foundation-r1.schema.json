{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/chinaneedM/ziwei-bazi-model/schemas/bazi-branch-relation-positional-context-foundation-r1.schema.json",
  "title": "Bazi Branch Relation Positional Context Foundation R1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "typed_schema", "status", "upstream_natal_fact_hash",
    "positional_profile", "candidate_counts", "candidates", "events", "diagnostics"
  ],
  "properties": {
    "schema": {"const": "BAZI-BRANCH-RELATION-POSITIONAL-CONTEXT-FOUNDATION-RESULT-V1"},
    "typed_schema": {"const": "BAZI-BRANCH-RELATION-POSITIONAL-TYPED-RESOLUTION-V1"},
    "status": {"enum": ["RESOLVED", "MULTI_CANDIDATE", "FAILED"]},
    "upstream_natal_fact_hash": {"$ref": "#/$defs/hash"},
    "positional_profile": {"$ref": "#/$defs/profile"},
    "candidate_counts": {"$ref": "#/$defs/candidateCounts"},
    "candidates": {"type": "array", "items": {"$ref": "#/$defs/candidate"}},
    "events": {"type": "array", "items": {"type": "string"}},
    "diagnostics": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nonEmptyIds": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "indices": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "integer", "minimum": 0}
    },
    "seedIds": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^BAZI-TEMPORAL-SEED:[0-9a-f]{64}$"}
    },
    "sourceRefs": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "profile": {
      "type": "object", "additionalProperties": false,
      "required": [
        "profile_id", "profile_version", "algorithm_id", "algorithm_version",
        "snapshot_rule_set_id", "snapshot_rule_set_version",
        "participant_position_rule_set_id", "participant_position_rule_set_version",
        "relation_position_rule_set_id", "relation_position_rule_set_version",
        "candidate_lineage_rule_set_id", "candidate_lineage_rule_set_version"
      ],
      "properties": {
        "profile_id": {"const": "BAZI-BRANCH-RELATION-POSITIONAL-CONTEXT-FOUNDATION-R1"},
        "profile_version": {"const": "1.0.0"},
        "algorithm_id": {"const": "BAZI-BRANCH-RELATION-POSITIONAL-ENGINE-V1"},
        "algorithm_version": {"const": "1.0.0"},
        "snapshot_rule_set_id": {"const": "BAZI-BRANCH-RELATION-POSITIONAL-SNAPSHOT-R1"},
        "snapshot_rule_set_version": {"const": "1.0.0"},
        "participant_position_rule_set_id": {"const": "BAZI-BRANCH-PARTICIPANT-POSITION-REFERENCE-R1"},
        "participant_position_rule_set_version": {"const": "1.0.0"},
        "relation_position_rule_set_id": {"const": "BAZI-BRANCH-RELATION-POSITIONAL-FACT-R1"},
        "relation_position_rule_set_version": {"const": "1.0.0"},
        "candidate_lineage_rule_set_id": {"const": "BAZI-BRANCH-POSITIONAL-INCIDENCE-LINEAGE-R1"},
        "candidate_lineage_rule_set_version": {"const": "1.0.0"}
      }
    },
    "candidateCounts": {
      "type": "object", "additionalProperties": false,
      "required": ["structural", "incidence"],
      "properties": {
        "structural": {"type": "integer", "minimum": 0},
        "incidence": {"type": "integer", "minimum": 0}
      }
    },
    "snapshot": {
      "type": "object", "additionalProperties": false,
      "required": [
        "snapshot_id", "snapshot_fact_hash", "source_incidence_snapshot_id",
        "source_incidence_snapshot_fact_hash", "source_incidence_fact_hash",
        "source_incidence_computation_hash", "source_natal_fact_hash",
        "source_natal_computation_hash", "source_temporal_fact_hash",
        "source_flow_fact_hash", "source_flow_computation_hash",
        "source_structural_fact_hash", "source_structural_computation_hash",
        "source_support_fact_hash", "source_support_computation_hash",
        "target_utc", "profile_id", "profile_version", "rule_set_id",
        "rule_set_version", "source_refs"
      ],
      "properties": {
        "snapshot_id": {"type": "string", "pattern": "^BRANCH_RELATION_POSITIONAL_SNAPSHOT:[0-9a-f]{64}$"},
        "snapshot_fact_hash": {"$ref": "#/$defs/hash"},
        "source_incidence_snapshot_id": {"type": "string", "pattern": "^RELATION_INCIDENCE_SNAPSHOT:[0-9a-f]{64}$"},
        "source_incidence_snapshot_fact_hash": {"$ref": "#/$defs/hash"},
        "source_incidence_fact_hash": {"$ref": "#/$defs/hash"},
        "source_incidence_computation_hash": {"$ref": "#/$defs/hash"},
        "source_natal_fact_hash": {"$ref": "#/$defs/hash"},
        "source_natal_computation_hash": {"$ref": "#/$defs/hash"},
        "source_temporal_fact_hash": {"$ref": "#/$defs/hash"},
        "source_flow_fact_hash": {"$ref": "#/$defs/hash"},
        "source_flow_computation_hash": {"$ref": "#/$defs/hash"},
        "source_structural_fact_hash": {"$ref": "#/$defs/hash"},
        "source_structural_computation_hash": {"$ref": "#/$defs/hash"},
        "source_support_fact_hash": {"$ref": "#/$defs/hash"},
        "source_support_computation_hash": {"$ref": "#/$defs/hash"},
        "target_utc": {"type": "string", "format": "date-time"},
        "profile_id": {"const": "BAZI-BRANCH-RELATION-POSITIONAL-CONTEXT-FOUNDATION-R1"},
        "profile_version": {"const": "1.0.0"},
        "rule_set_id": {"const": "BAZI-BRANCH-RELATION-POSITIONAL-SNAPSHOT-R1"},
        "rule_set_version": {"const": "1.0.0"},
        "source_refs": {"$ref": "#/$defs/sourceRefs"}
      }
    },
    "participantPosition": {
      "type": "object", "additionalProperties": false,
      "required": [
        "reference_id", "participant_instance_id", "branch", "element_affiliation",
        "participant_layer", "source_frame_id", "raw_position_token", "position_domain",
        "natal_pillar_ordinal", "source_upstream_fact_hash",
        "source_incidence_reference_ids", "rule_set_id", "rule_set_version", "source_refs"
      ],
      "properties": {
        "reference_id": {"type": "string", "pattern": "^BRANCH_PARTICIPANT_POSITION_REFERENCE:[0-9a-f]{64}$"},
        "participant_instance_id": {"type": "string", "minLength": 1},
        "branch": {"type": "string", "minLength": 1, "maxLength": 1},
        "element_affiliation": {"type": "string", "minLength": 1},
        "participant_layer": {"enum": ["NATAL", "DAYUN", "ANNUAL", "MONTHLY"]},
        "source_frame_id": {"type": ["string", "null"]},
        "raw_position_token": {"enum": ["YEAR", "MONTH", "DAY", "HOUR", "DAYUN", "ANNUAL", "MONTHLY"]},
        "position_domain": {"enum": ["NATAL_PILLAR", "TEMPORAL_FRAME"]},
        "natal_pillar_ordinal": {"type": ["integer", "null"], "minimum": 0, "maximum": 3},
        "source_upstream_fact_hash": {"$ref": "#/$defs/hash"},
        "source_incidence_reference_ids": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "string", "pattern": "^RELATION_OCCURRENCE_REFERENCE:"}
        },
        "rule_set_id": {"const": "BAZI-BRANCH-PARTICIPANT-POSITION-REFERENCE-R1"},
        "rule_set_version": {"const": "1.0.0"},
        "source_refs": {"$ref": "#/$defs/sourceRefs"}
      }
    },
    "relationPosition": {
      "type": "object", "additionalProperties": false,
      "required": [
        "positional_fact_id", "source_relation_reference_id", "source_relation_id",
        "source_semantic_relation_id", "source_relation_type", "source_relation_family",
        "participant_instance_ids", "participant_position_reference_ids",
        "raw_position_tokens", "position_domains", "participant_layers", "source_frame_ids",
        "source_orientation", "source_arity", "all_participants_natal_pillar",
        "natal_pillar_ordinals", "source_occurrence_kind",
        "source_occurrence_upstream_fact_hash", "source_relation_rule_set_id",
        "source_relation_rule_set_version", "source_incidence_snapshot_id",
        "source_incidence_snapshot_fact_hash", "source_incidence_fact_hash",
        "rule_set_id", "rule_set_version", "source_refs"
      ],
      "properties": {
        "positional_fact_id": {"type": "string", "pattern": "^BRANCH_RELATION_POSITIONAL_FACT:[0-9a-f]{64}$"},
        "source_relation_reference_id": {"type": "string", "pattern": "^RELATION_OCCURRENCE_REFERENCE:"},
        "source_relation_id": {"type": "string", "minLength": 1},
        "source_semantic_relation_id": {"type": "string", "minLength": 1},
        "source_relation_type": {"enum": [
          "BRANCH_LIUHE", "BRANCH_CHONG", "BRANCH_CHUAN", "BRANCH_SANHE_COMPLETE",
          "BRANCH_ZIMAO_PUNISHMENT", "BRANCH_DIRECTIONAL_PUNISHMENT", "BRANCH_SELF_PUNISHMENT"
        ]},
        "source_relation_family": {"enum": ["BRANCH_SIX_HARMONY", "BRANCH_CLASH", "BRANCH_CHUAN", "BRANCH_TRINE", "BRANCH_PUNISHMENT"]},
        "participant_instance_ids": {"type": "array", "minItems": 2, "maxItems": 3, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "participant_position_reference_ids": {"type": "array", "minItems": 2, "maxItems": 3, "uniqueItems": true, "items": {"type": "string", "pattern": "^BRANCH_PARTICIPANT_POSITION_REFERENCE:"}},
        "raw_position_tokens": {"type": "array", "minItems": 2, "maxItems": 3, "items": {"enum": ["YEAR", "MONTH", "DAY", "HOUR", "DAYUN", "ANNUAL", "MONTHLY"]}},
        "position_domains": {"type": "array", "minItems": 2, "maxItems": 3, "items": {"enum": ["NATAL_PILLAR", "TEMPORAL_FRAME"]}},
        "participant_layers": {"type": "array", "minItems": 2, "maxItems": 3, "items": {"enum": ["NATAL", "DAYUN", "ANNUAL", "MONTHLY"]}},
        "source_frame_ids": {"type": "array", "minItems": 2, "maxItems": 3, "items": {"type": ["string", "null"]}},
        "source_orientation": {"enum": ["SYMMETRIC", "DIRECTED", "SELF", "GROUP"]},
        "source_arity": {"enum": [2, 3]},
        "all_participants_natal_pillar": {"type": "boolean"},
        "natal_pillar_ordinals": {"type": "array", "maxItems": 3, "items": {"type": "integer", "minimum": 0, "maximum": 3}},
        "source_occurrence_kind": {"enum": ["NATAL_RELATION_CANDIDATE", "STRUCTURAL_DYNAMIC_RELATION_OCCURRENCE"]},
        "source_occurrence_upstream_fact_hash": {"$ref": "#/$defs/hash"},
        "source_relation_rule_set_id": {"type": "string", "minLength": 1},
        "source_relation_rule_set_version": {"type": "string", "minLength": 1},
        "source_incidence_snapshot_id": {"type": "string", "pattern": "^RELATION_INCIDENCE_SNAPSHOT:"},
        "source_incidence_snapshot_fact_hash": {"$ref": "#/$defs/hash"},
        "source_incidence_fact_hash": {"$ref": "#/$defs/hash"},
        "rule_set_id": {"const": "BAZI-BRANCH-RELATION-POSITIONAL-FACT-R1"},
        "rule_set_version": {"const": "1.0.0"},
        "source_refs": {"$ref": "#/$defs/sourceRefs"}
      }
    },
    "context": {
      "type": "object", "additionalProperties": false,
      "required": [
        "snapshot", "participant_position_references", "branch_relation_positional_facts",
        "profile_id", "profile_version", "algorithm_versions"
      ],
      "properties": {
        "snapshot": {"$ref": "#/$defs/snapshot"},
        "participant_position_references": {"type": "array", "items": {"$ref": "#/$defs/participantPosition"}},
        "branch_relation_positional_facts": {"type": "array", "items": {"$ref": "#/$defs/relationPosition"}},
        "profile_id": {"const": "BAZI-BRANCH-RELATION-POSITIONAL-CONTEXT-FOUNDATION-R1"},
        "profile_version": {"const": "1.0.0"},
        "algorithm_versions": {
          "type": "object", "additionalProperties": false,
          "required": ["positional", "snapshot", "participant_position", "relation_position", "candidate_lineage"],
          "properties": {
            "positional": {"const": "1.0.0"}, "snapshot": {"const": "1.0.0"},
            "participant_position": {"const": "1.0.0"}, "relation_position": {"const": "1.0.0"},
            "candidate_lineage": {"const": "1.0.0"}
          }
        }
      }
    },
    "diagnostic": {
      "type": "object", "additionalProperties": false,
      "required": ["code", "path", "detail"],
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "path": {"type": "string"},
        "detail": {"type": "string"}
      }
    },
    "integrity": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "diagnostics", "algorithm_id", "algorithm_version"],
      "properties": {
        "status": {"enum": ["PASS", "FAIL"]},
        "diagnostics": {"type": "array", "items": {"$ref": "#/$defs/diagnostic"}},
        "algorithm_id": {"const": "BAZI-BRANCH-RELATION-POSITIONAL-INTEGRITY-V1"},
        "algorithm_version": {"const": "1.0.0"}
      }
    },
    "hashes": {
      "type": "object", "additionalProperties": false,
      "required": ["fact_hash", "computation_hash", "algorithm_id", "algorithm_version"],
      "properties": {
        "fact_hash": {"$ref": "#/$defs/hash"},
        "computation_hash": {"$ref": "#/$defs/hash"},
        "algorithm_id": {"const": "BAZI-BRANCH-RELATION-POSITIONAL-HASH-V1"},
        "algorithm_version": {"const": "1.0.0"}
      }
    },
    "candidate": {
      "type": "object", "additionalProperties": false,
      "required": [
        "source_incidence_candidate_indices", "source_flow_candidate_indices",
        "source_structural_candidate_indices", "source_support_candidate_indices",
        "source_temporal_candidate_indices", "source_temporal_seed_ids",
        "source_incidence_lineage_binding_keys", "lineage_binding_keys",
        "context", "integrity", "hashes"
      ],
      "properties": {
        "source_incidence_candidate_indices": {"$ref": "#/$defs/indices"},
        "source_flow_candidate_indices": {"$ref": "#/$defs/indices"},
        "source_structural_candidate_indices": {"$ref": "#/$defs/indices"},
        "source_support_candidate_indices": {"$ref": "#/$defs/indices"},
        "source_temporal_candidate_indices": {"$ref": "#/$defs/indices"},
        "source_temporal_seed_ids": {"$ref": "#/$defs/seedIds"},
        "source_incidence_lineage_binding_keys": {"$ref": "#/$defs/nonEmptyIds"},
        "lineage_binding_keys": {"$ref": "#/$defs/nonEmptyIds"},
        "context": {"$ref": "#/$defs/context"},
        "integrity": {"$ref": "#/$defs/integrity"},
        "hashes": {"$ref": "#/$defs/hashes"}
      }
    }
  }
}
