{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/chinaneedM/ziwei-bazi-model/schemas/bazi-target-temporal-coordinate-foundation-r1.schema.json",
  "title": "Bazi Target Temporal Coordinate Foundation R1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "target_input",
    "profile_id",
    "profile_version",
    "effective_uncertainty_seconds_each_side",
    "sample_count",
    "ambiguous_sample_count",
    "candidates",
    "unresolved_samples",
    "diagnostics",
    "integrity",
    "hashes"
  ],
  "properties": {
    "schema": {"const": "BAZI-TARGET-TEMPORAL-COORDINATE-RESOLUTION-R1"},
    "status": {"enum": ["RESOLVED", "MULTI_CANDIDATE_OR_BOUNDARY_UNCERTAINTY", "FAILED"]},
    "target_input": {"$ref": "#/$defs/targetInput"},
    "profile_id": {"const": "BAZI-TARGET-TEMPORAL-COORDINATE-FOUNDATION-R1"},
    "profile_version": {"const": "1.0.0"},
    "effective_uncertainty_seconds_each_side": {"type": "integer", "minimum": 0},
    "sample_count": {"type": "integer", "minimum": 1},
    "ambiguous_sample_count": {"type": "integer", "minimum": 0},
    "candidates": {"type": "array", "items": {"$ref": "#/$defs/candidate"}},
    "unresolved_samples": {"type": "array", "items": {"$ref": "#/$defs/unresolvedSample"}},
    "diagnostics": {"type": "array", "items": {"type": "string"}},
    "integrity": {"$ref": "#/$defs/integrity"},
    "hashes": {"$ref": "#/$defs/hashes"}
  },
  "$defs": {
    "targetInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reported_local_datetime", "target_place", "latitude", "longitude", "timezone_id", "precision", "uncertainty_seconds"],
      "properties": {
        "reported_local_datetime": {"type": "string"},
        "target_place": {"type": "string", "minLength": 1},
        "latitude": {"type": "number", "minimum": -90, "maximum": 90},
        "longitude": {"type": "number", "minimum": -180, "maximum": 180},
        "timezone_id": {"type": "string", "minLength": 1},
        "precision": {"enum": ["EXACT_SECOND", "NEAREST_MINUTE", "NEAREST_HOUR", "APPROXIMATE"]},
        "uncertainty_seconds": {"type": "integer", "minimum": 0}
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id", "source_sample_index", "sample_reported_local_datetime", "civil_status",
        "timezone_id", "tzdb_version", "historical_confidence", "warnings", "target_utc", "fold",
        "utc_offset_seconds", "daylight_saving_seconds", "timezone_abbreviation",
        "local_mean_solar_datetime", "local_apparent_solar_datetime",
        "longitude_correction_seconds_from_civil", "equation_of_time_seconds",
        "apparent_solar_offset_from_utc_seconds", "solar_time_algorithm_id",
        "solar_time_algorithm_version", "time_scale_assumption"
      ],
      "properties": {
        "candidate_id": {"type": "string", "pattern": "^BAZI-TARGET-TEMPORAL-CANDIDATE:[0-9a-f]{64}$"},
        "source_sample_index": {"type": "integer", "minimum": 0},
        "sample_reported_local_datetime": {"type": "string"},
        "civil_status": {"enum": ["UNIQUE", "AMBIGUOUS"]},
        "timezone_id": {"type": "string"},
        "tzdb_version": {"type": "string"},
        "historical_confidence": {"enum": ["TZDB_POST_1970", "TZDB_PRE_1970_REDUCED"]},
        "warnings": {"type": "array", "items": {"type": "string"}},
        "target_utc": {"type": "string", "pattern": "Z$"},
        "fold": {"type": "integer", "enum": [0, 1]},
        "utc_offset_seconds": {"type": "integer"},
        "daylight_saving_seconds": {"type": "integer"},
        "timezone_abbreviation": {"type": "string"},
        "local_mean_solar_datetime": {"type": "string"},
        "local_apparent_solar_datetime": {"type": "string"},
        "longitude_correction_seconds_from_civil": {"type": "number"},
        "equation_of_time_seconds": {"type": "number"},
        "apparent_solar_offset_from_utc_seconds": {"type": "number"},
        "solar_time_algorithm_id": {"type": "string"},
        "solar_time_algorithm_version": {"type": "string"},
        "time_scale_assumption": {"type": "string"}
      }
    },
    "unresolvedSample": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_sample_index", "sample_reported_local_datetime", "civil_status", "timezone_id", "tzdb_version", "historical_confidence", "warnings"],
      "properties": {
        "source_sample_index": {"type": "integer", "minimum": 0},
        "sample_reported_local_datetime": {"type": "string"},
        "civil_status": {"enum": ["NONEXISTENT", "NOT_APPLICABLE"]},
        "timezone_id": {"type": "string"},
        "tzdb_version": {"type": "string"},
        "historical_confidence": {"enum": ["TZDB_POST_1970", "TZDB_PRE_1970_REDUCED", "NOT_RESOLVED"]},
        "warnings": {"type": "array", "items": {"type": "string"}}
      }
    },
    "integrityDiagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "path", "detail"],
      "properties": {
        "code": {"type": "string"},
        "path": {"type": "string"},
        "detail": {"type": "string"}
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "diagnostics", "algorithm_id", "algorithm_version"],
      "properties": {
        "status": {"enum": ["PASS", "FAIL"]},
        "diagnostics": {"type": "array", "items": {"$ref": "#/$defs/integrityDiagnostic"}},
        "algorithm_id": {"const": "BAZI-TARGET-TEMPORAL-COORDINATE-INTEGRITY-R1"},
        "algorithm_version": {"const": "1.0.0"}
      }
    },
    "hashes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fact_hash", "computation_hash", "algorithm_id", "algorithm_version"],
      "properties": {
        "fact_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "computation_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "algorithm_id": {"const": "BAZI-TARGET-TEMPORAL-COORDINATE-HASH-R1"},
        "algorithm_version": {"const": "1.0.0"}
      }
    }
  }
}
